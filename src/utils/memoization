import { useMemo, useCallback } from 'react';

export function useMemoizedObject(obj, deps = []) {
  return useMemo(() => obj, deps);
}

export function useMemoizedArray(arr, deps = []) {
  return useMemo(() => arr, deps);
}

export function useMemoizedCallback(callback, deps = []) {
  return useCallback(callback, deps);
}

// Memoize selector functions for useSelector
export function createSelector(...selectors) {
  return function memoizedSelector(state) {
    const selectedValues = selectors.map((selector) => selector(state));
    return selectedValues;
  };
}

// Deep equality check for objects
export function deepEqual(obj1, obj2) {
  if (obj1 === obj2) return true;
  if (obj1 == null || obj2 == null) return false;

  const keys1 = Object.keys(obj1);
  const keys2 = Object.keys(obj2);

  if (keys1.length !== keys2.length) return false;

  for (const key of keys1) {
    if (!keys2.includes(key)) return false;

    const val1 = obj1[key];
    const val2 = obj2[key];

    if (typeof val1 === 'object' && typeof val2 === 'object') {
      if (!deepEqual(val1, val2)) return false;
    } else if (val1 !== val2) {
      return false;
    }
  }

  return true;
}