{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "liberacion_taquillas_baja",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "liberar_taquillas": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "releaseEndedLockerAssignments"
          },
          "then": "end",
          "x-base44": {
            "title": "Liberar taquillas por baja",
            "description": "Deja disponibles las taquillas de los empleados con baja efectiva"
          }
        }
      }
    ]
  },
  "description": "Libera autom\u00e1ticamente la taquilla de los empleados dados de baja en cuanto llega su fecha de baja.",
  "name": "Liberaci\u00f3n de Taquillas por Baja (00:20)",
  "trigger": {
