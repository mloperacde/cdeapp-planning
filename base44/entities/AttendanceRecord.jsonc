{
  "name": "AttendanceRecord",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh' or user.role == 'supervisor'}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": [
        "E",
        "S"
      ]
    },
    "incident": {
      "type": "string"
    },
    "center": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "device": {
      "type": "string"
    },
    "record_date": {
      "type": "string",
      "format": "date"
    },
    "record_time": {
      "type": "string"
    },
    "import_batch": {
      "type": "string"
    }
  },
  "required": [
    "employee_id",
    "employee_name",
    "direction",
    "record_date",
    "record_time"
  ]
}