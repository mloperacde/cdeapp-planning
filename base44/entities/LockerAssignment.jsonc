{
  "name": "LockerAssignment",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh' or user.employee_id == employee_id}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "requiere_taquilla": {
      "type": "boolean",
      "default": true
    },
    "vestuario": {
      "type": "string",
      "enum": [
        "Vestuario Femenino Planta Baja",
        "Vestuario Femenino Planta Alta",
        "Vestuario Masculino Planta Baja"
      ]
    },
    "numero_taquilla_actual": {
      "type": "string"
    },
    "numero_taquilla_nuevo": {
      "type": "string"
    },
    "fecha_asignacion": {
      "type": "string",
      "format": "date-time"
    },
    "historial_cambios": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "notas": {
      "type": "string"
    },
    "notificacion_enviada": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "employee_id"
  ]
}