{
  "name": "MachineProcess",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "machine_id": {
      "type": "string",
      "description": "ID de la máquina"
    },
    "process_id": {
      "type": "string",
      "description": "ID del proceso"
    },
    "operadores_requeridos": {
      "type": "number",
      "default": 1,
      "description": "Número de operadores requeridos para este proceso en esta máquina"
    },
    "orden": {
      "type": "number",
      "default": 0,
      "description": "Orden de visualización del proceso en la máquina"
    },
    "activo": {
      "type": "boolean",
      "default": true,
      "description": "Si esta configuración está activa"
    }
  },
  "required": [
    "machine_id",
    "process_id",
    "operadores_requeridos"
  ]
}
