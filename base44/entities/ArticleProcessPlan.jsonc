{
  "name": "ArticleProcessPlan",
  "type": "object",
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "rrhh"
          }
        },
        {
          "user_condition": {
            "role": "hr_manager"
          }
        },
        {
          "user_condition": {
            "role": "supervisor"
          }
        },
        {
          "user_condition": {
            "role": "jefe_turno"
          }
        },
        {
          "user_condition": {
            "role": "shift_manager_production"
          }
        },
        {
          "user_condition": {
            "role": "prod_supervisor"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "rrhh"
          }
        },
        {
          "user_condition": {
            "role": "hr_manager"
          }
        },
        {
          "user_condition": {
            "role": "supervisor"
          }
        },
        {
          "user_condition": {
            "role": "jefe_turno"
          }
        },
        {
          "user_condition": {
            "role": "shift_manager_production"
          }
        },
        {
          "user_condition": {
            "role": "prod_supervisor"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Admin"
          }
        }
      ]
    }
  },
  "properties": {
    "tipo": {
      "type": "string",
      "enum": [
        "Plantilla",
        "Orden"
      ],
      "default": "Plantilla",
      "description": "Plantilla reutilizable o cronograma de una orden concreta"
    },
    "nombre": {
      "type": "string",
      "description": "Nombre del diagrama de proceso"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo interno del diagrama"
    },
    "descripcion": {
      "type": "string"
    },
    "room_layout_id": {
      "type": "string",
      "description": "ID del RoomLayout (l\u00ednea de envasado)"
    },
    "room_layout_name": {
      "type": "string",
      "description": "Nombre de la l\u00ednea (desnormalizado)"
    },
    "process_id": {
      "type": "string"
    },
    "process_name": {
      "type": "string"
    },
    "order_reference": {
      "type": "string",
      "description": "Referencia de la orden de trabajo (solo tipo Orden)"
    },
    "product_name": {
      "type": "string",
      "description": "Producto de la orden"
    },
    "quantity": {
      "type": "number",
      "description": "Cantidad planificada"
    },
    "hito_fecha": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora del hito de inicio de producci\u00f3n"
    },
    "source_plan_id": {
      "type": "string",
      "description": "Plantilla desde la que se gener\u00f3 el cronograma"
    },
    "source_plan_name": {
      "type": "string"
    },
    "familias": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Familias / categor\u00edas de art\u00edculo cubiertas por el diagrama"
    },
    "linked_articles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "article_id": {
            "type": "string"
          },
          "article_code": {
            "type": "string"
          },
          "article_name": {
            "type": "string"
          },
          "familia": {
            "type": "string"
          },
          "linked_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Art\u00edculos vinculados manualmente"
    },
    "hito_nombre": {
      "type": "string",
      "default": "Inicio de producci\u00f3n",
      "description": "Hito de referencia temporal del diagrama"
    },
    "actividades": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "orden": {
            "type": "number"
          },
          "nombre": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "description": "Tipo de origen importado (workOrder, maintenance, process...)"
          },
          "fase": {
            "type": "string",
            "enum": [
              "Preparaci\u00f3n",
              "Producci\u00f3n",
              "Cierre"
            ]
          },
          "unidad": {
            "type": "string",
            "enum": [
              "Minutos",
              "Horas"
            ],
            "default": "Minutos",
            "description": "Unidad de entrada de offset y duraci\u00f3n (se guardan siempre en minutos)"
          },
          "estacion_element_id": {
            "type": "string"
          },
          "estacion_nombre": {
            "type": "string"
          },
          "maquina_id": {
            "type": "string"
          },
          "maquina_nombre": {
            "type": "string"
          },
          "duracion_minutos": {
            "type": "number"
          },
          "offset_minutos": {
            "type": "number",
            "description": "Minutos respecto al hito. Negativo = antes del hito"
          },
          "responsable": {
            "type": "string"
          },
          "notas": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "Borrador",
        "En Revisi\u00f3n",
        "Aprobado",
        "Obsoleto"
      ],
      "default": "Borrador"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "nombre"
  ]
}