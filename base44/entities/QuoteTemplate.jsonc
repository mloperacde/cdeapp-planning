{
  "name": "QuoteTemplate",
  "type": "object",
  "properties": {
    "quote_number": {
      "type": "string",
      "description": "N\u00famero \u00fanico de presupuesto (ej: QUOTE-2024-001)"
    },
    "client_name": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "client_email": {
      "type": "string",
      "format": "email",
      "description": "Email del cliente"
    },
    "client_phone": {
      "type": "string",
      "description": "Tel\u00e9fono del cliente"
    },
    "client_company": {
      "type": "string",
      "description": "Nombre de la empresa del cliente"
    },
    "quote_type": {
      "type": "string",
      "enum": [
        "ENVASADO_SOLO",
        "SERVICIO_360"
      ],
      "description": "Tipo de presupuesto"
    },
    "product_type": {
      "type": "string",
      "enum": [
        "cosmetico",
        "perfumeria",
        "sanitario",
        "alimenticio"
      ],
      "description": "Tipo de producto a envasar"
    },
    "volume": {
      "type": "number",
      "description": "Volumen de unidades a envasar"
    },
    "container_type": {
      "type": "string",
      "enum": [
        "frasco",
        "bote",
        "blister",
        "carton",
        "bolsa",
        "otro"
      ],
      "description": "Tipo de envase"
    },
    "filling_system": {
      "type": "string",
      "enum": [
        "bomba_peristaltica",
        "piston",
        "masa",
        "volumetrica"
      ],
      "description": "Sistema de llenado"
    },
    "labeling_system": {
      "type": "string",
      "enum": [
        "semiautomatico",
        "automatico",
        "manual"
      ],
      "description": "Sistema de etiquetado"
    },
    "capping_system": {
      "type": "string",
      "enum": [
        "manual",
        "semiautomatico",
        "automatico"
      ],
      "description": "Sistema de taponado/cerrado"
    },
    "line_type": {
      "type": "string",
      "enum": [
        "linea_completa",
        "maquinas_especificas"
      ],
      "description": "L\u00ednea completa o m\u00e1quinas espec\u00edficas"
    },
    "selected_machines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "machine_id": {
            "type": "string"
          },
          "machine_name": {
            "type": "string"
          },
          "daily_capacity": {
            "type": "number"
          }
        }
      },
      "description": "M\u00e1quinas seleccionadas"
    },
    "special_requirements": {
      "type": "string",
      "description": "Requisitos especiales (normativas, certificaciones, etc.)"
    },
    "delivery_days": {
      "type": "number",
      "description": "Plazo de entrega en d\u00edas"
    },
    "materials_supply": {
      "type": "object",
      "properties": {
        "blisters": {
          "type": "boolean"
        },
        "printed_cards": {
          "type": "boolean"
        },
        "caps": {
          "type": "boolean"
        },
        "pumps": {
          "type": "boolean"
        },
        "labels": {
          "type": "boolean"
        },
        "other": {
          "type": "string"
        }
      },
      "description": "Materiales a suministrar (solo para SERVICIO_360)"
    },
    "distribution_included": {
      "type": "boolean",
      "default": false,
      "description": "Incluye distribuci\u00f3n a puntos de venta"
    },
    "price_breakdown": {
      "type": "object",
      "properties": {
        "labor_cost": {
          "type": "number"
        },
        "machine_cost": {
          "type": "number"
        },
        "material_cost": {
          "type": "number"
        },
        "distribution_cost": {
          "type": "number"
        },
        "subtotal": {
          "type": "number"
        },
        "tax_percentage": {
          "type": "number"
        },
        "total": {
          "type": "number"
        }
      },
      "description": "Desglose de precios"
    },
    "status": {
      "type": "string",
      "enum": [
        "borrador",
        "enviado",
        "aprobado",
        "rechazado",
        "cancelado"
      ],
      "default": "borrador",
      "description": "Estado del presupuesto"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales"
    },
    "pdf_url": {
      "type": "string",
      "description": "URL del PDF generado"
    },
    "sent_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de env\u00edo al cliente"
    },
    "approval_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de aprobaci\u00f3n"
    },
    "validity_days": {
      "type": "number",
      "default": 30,
      "description": "D\u00edas de validez del presupuesto"
    }
  },
  "required": [
    "quote_number",
    "client_name",
    "quote_type",
    "product_type",
    "volume",
    "container_type"
  ]
}