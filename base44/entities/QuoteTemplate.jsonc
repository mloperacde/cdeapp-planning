{
  "name": "QuoteTemplate",
  "type": "object",
  "properties": {
    "quote_number": {
      "type": "string",
      "description": "N\u00famero \u00fanico de presupuesto (ej: PRES-2025-0001)"
    },
    "client_name": {
      "type": "string",
      "description": "Nombre del cliente o contacto"
    },
    "client_email": {
      "type": "string",
      "format": "email",
      "description": "Email del cliente"
    },
    "client_phone": {
      "type": "string",
      "description": "Tel\u00e9fono del cliente"
    },
    "client_company": {
      "type": "string",
      "description": "Nombre de la empresa del cliente"
    },
    "client_address": {
      "type": "string",
      "description": "Direcci\u00f3n de la empresa cliente"
    },
    "quote_type": {
      "type": "string",
      "enum": [
        "ENVASADO_SOLO",
        "SERVICIO_360"
      ],
      "description": "Tipo de presupuesto: Maquila pura o Llave en mano"
    },
    "product_type": {
      "type": "string",
      "enum": [
        "cosmetico",
        "perfumeria",
        "sanitario",
        "alimenticio",
        "otro"
      ],
      "description": "Categor\u00eda del producto a envasar"
    },
    "product_description": {
      "type": "string",
      "description": "Descripci\u00f3n detallada del producto (ej: Crema Hidratante Facial 50ml)"
    },
    "product_texture": {
      "type": "string",
      "enum": [
        "liquido",
        "crema",
        "gel",
        "polvo",
        "solido",
        "emulsion",
        "spray",
        "otro"
      ],
      "description": "Textura/consistencia del producto"
    },
    "volume": {
      "type": "number",
      "description": "Cantidad de unidades a envasar (MOQ)"
    },
    "unit_volume_ml": {
      "type": "number",
      "description": "Volumen por unidad en ml/gr"
    },
    "container_type": {
      "type": "string",
      "enum": [
        "frasco",
        "bote",
        "tarro",
        "sachet",
        "sachet_toallita",
        "ampolla",
        "blister",
        "tubo",
        "sobre",
        "carton",
        "otro"
      ],
      "description": "Tipo de envase primario"
    },
    "container_material": {
      "type": "string",
      "enum": [
        "vidrio",
        "pet",
        "hdpe",
        "aluminio",
        "papel",
        "laminado",
        "otro"
      ],
      "description": "Material del envase"
    },
    "closure_type": {
      "type": "string",
      "enum": [
        "rosca",
        "flip_top",
        "bomba",
        "spray",
        "gotero",
        "induccion",
        "soldadura",
        "otro"
      ],
      "description": "Tipo de cierre"
    },
    "filling_system": {
      "type": "string",
      "enum": [
        "bomba_peristaltica",
        "piston",
        "masa",
        "volumetrica",
        "dosificadora_polvo",
        "termoformado",
        "soldadura_calor"
      ],
      "description": "Sistema de llenado"
    },
    "labeling_system": {
      "type": "string",
      "enum": [
        "manual",
        "semiautomatico",
        "automatico"
      ],
      "description": "Sistema de etiquetado"
    },
    "coding_system": {
      "type": "string",
      "enum": [
        "inkjet",
        "laser",
        "termotransferencia",
        "manual",
        "ninguno"
      ],
      "description": "Sistema de codificaci\u00f3n lote/caducidad"
    },
    "packaging_type": {
      "type": "string",
      "enum": [
        "estuche",
        "flow_pack",
        "termoretractil",
        "film",
        "ninguno",
        "otro"
      ],
      "description": "Tipo de empaquetado secundario"
    },
    "line_type": {
      "type": "string",
      "enum": [
        "linea_completa",
        "maquinas_especificas"
      ],
      "description": "L\u00ednea completa o m\u00e1quinas espec\u00edficas"
    },
    "special_requirements": {
      "type": "string",
      "description": "Normativas/Certificaciones: GMP, ISO 22716, APPCC, ISO 13485, ATEX..."
    },
    "delivery_days": {
      "type": "number",
      "description": "Plazo de entrega estimado en d\u00edas laborables"
    },
    "validity_days": {
      "type": "number",
      "default": 30,
      "description": "D\u00edas de validez del presupuesto"
    },
    "service_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "concept": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "unit_cost": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "is_fixed": {
            "type": "boolean",
            "description": "true = coste fijo (set-up); false = coste por unidad"
          }
        }
      },
      "description": "L\u00edneas de servicio del presupuesto (PROD-01, ENV-01, ACAB-01...)"
    },
    "materials_supply": {
      "type": "object",
      "properties": {
        "envase_primario": {
          "type": "boolean"
        },
        "envase_primario_descripcion": {
          "type": "string"
        },
        "envase_primario_coste": {
          "type": "number"
        },
        "cierre": {
          "type": "boolean"
        },
        "cierre_descripcion": {
          "type": "string"
        },
        "cierre_coste": {
          "type": "number"
        },
        "etiqueta": {
          "type": "boolean"
        },
        "etiqueta_descripcion": {
          "type": "string"
        },
        "etiqueta_coste": {
          "type": "number"
        },
        "packaging_secundario": {
          "type": "boolean"
        },
        "packaging_secundario_descripcion": {
          "type": "string"
        },
        "packaging_secundario_coste": {
          "type": "number"
        },
        "materia_prima": {
          "type": "boolean"
        },
        "materia_prima_descripcion": {
          "type": "string"
        },
        "materia_prima_coste": {
          "type": "number"
        },
        "margen_gestion": {
          "type": "number",
          "default": 15,
          "description": "% margen sobre materiales gestionados"
        }
      },
      "description": "Materiales a suministrar en SERVICIO_360"
    },
    "distribution_included": {
      "type": "boolean",
      "default": false
    },
    "distribution_cost": {
      "type": "number",
      "description": "Coste de distribuci\u00f3n si aplica"
    },
    "quality_services": {
      "type": "object",
      "properties": {
        "microbiological_analysis": {
          "type": "boolean"
        },
        "microbiological_cost": {
          "type": "number"
        },
        "stability_test": {
          "type": "boolean"
        },
        "stability_cost": {
          "type": "number"
        },
        "regulatory_management": {
          "type": "boolean"
        },
        "regulatory_cost": {
          "type": "number"
        }
      },
      "description": "Servicios de calidad y regulatorio"
    },
    "commercial_conditions": {
      "type": "object",
      "properties": {
        "moq_note": {
          "type": "string",
          "description": "Nota sobre cantidad m\u00ednima"
        },
        "waste_percentage": {
          "type": "number",
          "default": 3,
          "description": "% merma t\u00e9cnica aceptada"
        },
        "incoterm": {
          "type": "string",
          "enum": [
            "EXW",
            "DDP",
            "FCA"
          ],
          "default": "EXW"
        },
        "storage_days_free": {
          "type": "number",
          "default": 15
        },
        "storage_cost_per_pallet": {
          "type": "number"
        },
        "payment_terms": {
          "type": "string"
        },
        "ip_ownership": {
          "type": "string"
        }
      }
    },
    "price_breakdown": {
      "type": "object",
      "properties": {
        "setup_cost": {
          "type": "number"
        },
        "services_subtotal": {
          "type": "number"
        },
        "materials_cost": {
          "type": "number"
        },
        "quality_cost": {
          "type": "number"
        },
        "distribution_cost": {
          "type": "number"
        },
        "subtotal": {
          "type": "number"
        },
        "tax_percentage": {
          "type": "number",
          "default": 21
        },
        "tax_amount": {
          "type": "number"
        },
        "total": {
          "type": "number"
        },
        "unit_price": {
          "type": "number",
          "description": "Precio por unidad (sin IVA)"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "borrador",
        "enviado",
        "aprobado",
        "rechazado",
        "cancelado"
      ],
      "default": "borrador"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales y condiciones espec\u00edficas"
    },
    "internal_notes": {
      "type": "string",
      "description": "Notas internas (no aparecen en el PDF)"
    },
    "pdf_url": {
      "type": "string"
    },
    "sent_date": {
      "type": "string",
      "format": "date-time"
    },
    "approval_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "quote_number",
    "client_name",
    "quote_type",
    "product_type",
    "volume"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "Comercial"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Comercial"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}