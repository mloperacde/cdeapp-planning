{
  "name": "EmployeeMachineSkill",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh' or user.role == 'supervisor' or user.employee_id == employee_id}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "ID del empleado"
    },
    "machine_id": {
      "type": "string",
      "description": "ID de la m\u00e1quina"
    },
    "nivel_habilidad": {
      "type": "string",
      "enum": [
        "Principiante",
        "Intermedio",
        "Avanzado",
        "Experto"
      ],
      "default": "Intermedio"
    },
    "certificado": {
      "type": "boolean",
      "default": false
    },
    "fecha_certificacion": {
      "type": "string",
      "format": "date"
    },
    "experiencia_anos": {
      "type": "number"
    },
    "observaciones": {
      "type": "string"
    },
    "orden_preferencia": {
      "type": "number"
    }
  },
  "required": [
    "employee_id",
    "machine_id"
  ]
}