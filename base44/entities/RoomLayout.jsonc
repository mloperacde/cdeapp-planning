{
  "name": "RoomLayout",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "room_name": {
      "type": "string"
    },
    "canvas_width": {
      "type": "number",
      "default": 1200
    },
    "canvas_height": {
      "type": "number",
      "default": 800
    },
    "layout_elements": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "room_polygon": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Puntos del pol\u00edgono de la sala"
    },
    "floor_color": {
      "type": "string",
      "default": "#475569",
      "description": "Color del suelo de la sala"
    },
    "background_image_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Borrador",
        "Aprobado",
        "Archivado"
      ],
      "default": "Borrador"
    },
    "linked_articles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "article_id": {
            "type": "string",
            "description": "ID del art\u00edculo en la BD"
          },
          "article_code": {
            "type": "string",
            "description": "C\u00f3digo del art\u00edculo"
          },
          "article_description": {
            "type": "string",
            "description": "Descripci\u00f3n/nombre del art\u00edculo"
          },
          "linked_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Art\u00edculos vinculados a este layout (var\u00eda seg\u00fan el art\u00edculo a producir)"
    },
    "element_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "element_type": {
            "type": "string",
            "description": "Tipo de elemento (machine, conveyor_belt, etc.)"
          },
          "label": {
            "type": "string",
            "description": "Etiqueta descriptiva del elemento"
          },
          "quantity": {
            "type": "number",
            "description": "Cantidad necesaria"
          },
          "auto_generated": {
            "type": "boolean",
            "default": true,
            "description": "Si fue auto-generado desde el layout"
          },
          "notes": {
            "type": "string",
            "description": "Notas adicionales sobre este elemento del inventario"
          }
        }
      },
      "description": "Inventario de elementos necesarios seg\u00fan la configuraci\u00f3n del layout"
    }
  },
  "required": [
    "name",
    "room_name"
  ]
}