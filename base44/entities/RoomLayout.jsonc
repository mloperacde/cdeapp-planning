{
  "name": "RoomLayout",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "room_name": {
      "type": "string"
    },
    "canvas_width": {
      "type": "number",
      "default": 1200
    },
    "canvas_height": {
      "type": "number",
      "default": 800
    },
    "layout_elements": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "background_image_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Borrador",
        "Aprobado",
        "Archivado"
      ],
      "default": "Borrador"
    }
  },
  "required": [
    "name",
    "room_name"
  ]
}