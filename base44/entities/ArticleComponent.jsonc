{
  "name": "ArticleComponent",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "cde_id": {
      "type": "integer",
      "description": "ID original en CDEApp"
    },
    "article_cde_id": {
      "type": "integer",
      "description": "ID del artículo en CDEApp (article_id de la API)"
    },
    "article_id": {
      "type": "string",
      "description": "ID del artículo en nuestra BD (referencia a Article)"
    },
    "code_component": {
      "type": "string",
      "description": "Código del componente"
    },
    "name_component": {
      "type": "string",
      "description": "Nombre del componente"
    },
    "reference_component": {
      "type": "string",
      "description": "Referencia del componente"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "updated_at_cde": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de actualización en CDEApp"
    }
  },
  "required": [
    "article_cde_id",
    "code_component",
    "name_component"
  ]
}
