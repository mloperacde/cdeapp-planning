{
  "name": "Document",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{es_publico or user.role == 'admin' or user.role in roles_acceso or (departamentos_acceso is empty or user.department_id in departamentos_acceso)}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "titulo": {
      "type": "string"
    },
    "descripcion": {
      "type": "string"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Manual de M\u00e1quina",
        "Pol\u00edtica PRL",
        "Procedimiento de Ausencia",
        "Pol\u00edtica RRHH",
        "Certificado",
        "Contrato",
        "Formaci\u00f3n",
        "Calidad",
        "Otro"
      ]
    },
    "tipo_entidad_asociada": {
      "type": "string",
      "enum": [
        "Machine",
        "Employee",
        "Process",
        "AbsenceType",
        "Skill",
        "TrainingModule",
        "General"
      ]
    },
    "entidad_asociada_id": {
      "type": "string"
    },
    "archivo_url": {
      "type": "string"
    },
    "tipo_archivo": {
      "type": "string"
    },
    "tamano_bytes": {
      "type": "number"
    },
    "version": {
      "type": "string",
      "default": "1.0"
    },
    "estado": {
      "type": "string",
      "enum": [
        "Borrador",
        "Vigente",
        "Obsoleto",
        "Archivado"
      ],
      "default": "Vigente"
    },
    "fecha_creacion": {
      "type": "string",
      "format": "date-time"
    },
    "fecha_vigencia": {
      "type": "string",
      "format": "date"
    },
    "fecha_caducidad": {
      "type": "string",
      "format": "date"
    },
    "roles_acceso": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "departamentos_acceso": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "es_publico": {
      "type": "boolean",
      "default": false
    },
    "historial_versiones": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "etiquetas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contenido_indexado": {
      "type": "string"
    },
    "subido_por": {
      "type": "string"
    },
    "ultima_modificacion": {
      "type": "string",
      "format": "date-time"
    },
    "modificado_por": {
      "type": "string"
    },
    "contador_descargas": {
      "type": "number",
      "default": 0
    },
    "ultima_descarga": {
      "type": "string",
      "format": "date-time"
    },
    "cambios_recientes": {
      "type": "string"
    }
  },
  "required": [
    "titulo",
    "categoria",
    "archivo_url"
  ]
}