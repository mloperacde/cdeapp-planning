{
  "name": "EmployeeSalary",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh' or user.employee_id == employee_id}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "ID del empleado"
    },
    "employee_name": {
      "type": "string",
      "description": "Nombre del empleado"
    },
    "employee_code": {
      "type": "string",
      "description": "C\u00f3digo del empleado"
    },
    "component_id": {
      "type": "string",
      "description": "ID del componente salarial"
    },
    "component_name": {
      "type": "string",
      "description": "Nombre del componente"
    },
    "component_code": {
      "type": "string",
      "description": "C\u00f3digo del componente"
    },
    "amount": {
      "type": "number",
      "description": "Cantidad asignada"
    },
    "percentage": {
      "type": "number",
      "description": "Porcentaje si aplica"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "is_current": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "approval_date": {
      "type": "string",
      "format": "date-time"
    },
    "requires_approval": {
      "type": "boolean",
      "default": false
    },
    "change_request_id": {
      "type": "string"
    },
    "previous_version_id": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "employee_id",
    "component_id",
    "amount",
    "start_date"
  ]
}