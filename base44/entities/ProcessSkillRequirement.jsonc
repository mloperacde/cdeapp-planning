{
  "name": "ProcessSkillRequirement",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "process_id": {
      "type": "string"
    },
    "skill_id": {
      "type": "string"
    },
    "nivel_minimo_requerido": {
      "type": "string",
      "enum": [
        "Básico",
        "Intermedio",
        "Avanzado",
        "Experto"
      ],
      "default": "Básico"
    },
    "obligatorio": {
      "type": "boolean",
      "default": true
    },
    "prioridad": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "process_id",
    "skill_id",
    "nivel_minimo_requerido"
  ]
}
