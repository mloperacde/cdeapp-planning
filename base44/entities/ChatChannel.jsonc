{
  "name": "ChatChannel",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.id in admins or user.employee_id in participantes or user.role == 'admin'}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.id in admins or user.role == 'admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "nombre": {
      "type": "string"
    },
    "descripcion": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Direct",
        "Equipo",
        "Departamento",
        "General"
      ],
      "default": "General"
    },
    "equipo": {
      "type": "string"
    },
    "departamento": {
      "type": "string"
    },
    "participantes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "admins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "activo": {
      "type": "boolean",
      "default": true
    },
    "ultimo_mensaje_fecha": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "nombre",
    "tipo"
  ]
}