{
  "name": "DailyPresence",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'rrhh' or user.role == 'supervisor'}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "ID del empleado en la base maestra"
    },
    "employee_name": {
      "type": "string",
      "description": "Nombre del empleado (desnormalizado)"
    },
    "employee_code": {
      "type": "string",
      "description": "C\u00f3digo del empleado en Cuco360 (desnormalizado)"
    },
    "record_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha del fichaje (yyyy-MM-dd)"
    },
    "present": {
      "type": "boolean",
      "default": true,
      "description": "Si el empleado estuvo presente (tuvo al menos un fichaje en el d\u00eda)"
    },
    "shift": {
      "type": "string",
      "description": "Turno detectado seg\u00fan hora de primera entrada (Ma\u00f1ana/Tarde)"
    },
    "first_entry": {
      "type": "string",
      "description": "Hora de primera entrada (HH:MM)"
    },
    "last_exit": {
      "type": "string",
      "description": "Hora de \u00faltima salida (HH:MM) \u2014 solo si el \u00faltimo fichaje del d\u00eda es 'S'"
    },
    "check_in_count": {
      "type": "number",
      "description": "N\u00famero total de fichajes del d\u00eda"
    },
    "source": {
      "type": "string",
      "default": "cuco360",
      "description": "Origen de los datos"
    },
    "expected_start": {
      "type": "string",
      "description": "Hora de entrada esperada seg\u00fan turno (HH:MM)"
    },
    "expected_end": {
      "type": "string",
      "description": "Hora de salida esperada seg\u00fan turno (HH:MM)"
    },
    "minutes_late": {
      "type": "number",
      "default": 0,
      "description": "Minutos de retraso sobre la entrada esperada"
    },
    "minutes_early": {
      "type": "number",
      "default": 0,
      "description": "Minutos de salida anticipada antes de la salida esperada"
    },
    "expected_minutes": {
      "type": "number",
      "default": 0,
      "description": "Minutos de jornada esperados seg\u00fan turno"
    },
    "actual_minutes": {
      "type": "number",
      "default": 0,
      "description": "Minutos reales trabajados (\u00faltima salida - primera entrada)"
    },
    "missing_minutes": {
      "type": "number",
      "default": 0,
      "description": "Minutos no trabajados (retraso + salida anticipada)"
    },
    "compliance_status": {
      "type": "string",
      "enum": [
        "Completa",
        "Retraso",
        "Salida Anticipada",
        "Incompleta",
        "En Curso",
        "Sin Turno",
        "Ausente",
        "Sin Salida",
        "Sin Datos"
      ],
      "default": "Sin Datos",
      "description": "Estado de cumplimiento de jornada"
    }
  },
  "required": [
    "employee_id",
    "record_date"
  ]
}