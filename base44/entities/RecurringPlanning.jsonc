{
  "name": "RecurringPlanning",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'jefe_turno'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'jefe_turno'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "machine_id": {
      "type": "string"
    },
    "process_id": {
      "type": "string"
    },
    "team_key": {
      "type": "string",
      "enum": [
        "team_1",
        "team_2"
      ]
    },
    "fecha_inicio": {
      "type": "string",
      "format": "date"
    },
    "fecha_fin": {
      "type": "string",
      "format": "date"
    },
    "tipo_recurrencia": {
      "type": "string",
      "enum": [
        "Diaria",
        "Semanal",
        "Mensual"
      ]
    },
    "intervalo": {
      "type": "number",
      "default": 1
    },
    "dias_semana": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "activa": {
      "type": "boolean",
      "default": true
    },
    "operadores_necesarios": {
      "type": "number"
    }
  },
  "required": [
    "machine_id",
    "team_key",
    "fecha_inicio",
    "tipo_recurrencia"
  ]
}
