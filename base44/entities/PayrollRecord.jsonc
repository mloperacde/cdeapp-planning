{
  "name": "PayrollRecord",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh' or user.employee_id == employee_id}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "employee_code": {
      "type": "string"
    },
    "payroll_period": {
      "type": "string"
    },
    "pay_period_start": {
      "type": "string",
      "format": "date"
    },
    "pay_period_end": {
      "type": "string",
      "format": "date"
    },
    "payment_date": {
      "type": "string",
      "format": "date"
    },
    "actual_payment_date": {
      "type": "string",
      "format": "date"
    },
    "gross_salary": {
      "type": "number"
    },
    "salary_components": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "deductions": {
      "type": "object"
    },
    "employer_contributions": {
      "type": "object"
    },
    "net_salary": {
      "type": "number"
    },
    "total_cost": {
      "type": "number"
    },
    "worked_days": {
      "type": "number"
    },
    "absence_days": {
      "type": "number",
      "default": 0
    },
    "extra_hours": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "Borrador",
        "Calculada",
        "Validada",
        "Aprobada",
        "Procesada",
        "Pagada"
      ],
      "default": "Borrador"
    },
    "payslip_url": {
      "type": "string"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "Transferencia Bancaria",
        "Cheque",
        "Efectivo"
      ],
      "default": "Transferencia Bancaria"
    },
    "bank_reference": {
      "type": "string"
    },
    "processed_by": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "employee_id",
    "payroll_period",
    "pay_period_start",
    "pay_period_end"
  ]
}