{
  "name": "WorkIncident",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh' or user.role == 'supervisor'}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "codigo_incidente": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Accidente",
        "Incidente",
        "Casi Accidente"
      ]
    },
    "employee_id": {
      "type": "string"
    },
    "fecha_hora": {
      "type": "string",
      "format": "date-time"
    },
    "lugar": {
      "type": "string"
    },
    "departamento": {
      "type": "string"
    },
    "descripcion": {
      "type": "string"
    },
    "gravedad": {
      "type": "string",
      "enum": [
        "Leve",
        "Grave",
        "Muy Grave",
        "Mortal"
      ]
    },
    "parte_cuerpo_afectada": {
      "type": "string"
    },
    "dias_baja": {
      "type": "number",
      "default": 0
    },
    "testigos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "causas_inmediatas": {
      "type": "string"
    },
    "causas_basicas": {
      "type": "string"
    },
    "medidas_correctoras": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "investigado_por": {
      "type": "string"
    },
    "fecha_investigacion": {
      "type": "string",
      "format": "date"
    },
    "notificado_autoridad": {
      "type": "boolean",
      "default": false
    },
    "fecha_notificacion_autoridad": {
      "type": "string",
      "format": "date"
    },
    "estado_investigacion": {
      "type": "string",
      "enum": [
        "Pendiente",
        "En Curso",
        "Completada",
        "Cerrada"
      ],
      "default": "Pendiente"
    },
    "documento_investigacion_url": {
      "type": "string"
    },
    "fotos_url": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notas": {
      "type": "string"
    }
  },
  "required": [
    "tipo",
    "employee_id",
    "fecha_hora",
    "descripcion",
    "gravedad"
  ]
}