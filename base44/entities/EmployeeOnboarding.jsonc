{
  "name": "EmployeeOnboarding",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh' or user.employee_id == employee_id}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "ID del empleado"
    },
    "estado": {
      "type": "string",
      "enum": [
        "En Proceso",
        "Completado",
        "Pendiente"
      ],
      "default": "En Proceso"
    },
    "fecha_inicio": {
      "type": "string",
      "format": "date"
    },
    "fecha_completado": {
      "type": "string",
      "format": "date"
    },
    "paso_actual": {
      "type": "number",
      "default": 1
    },
    "pasos_completados": {
      "type": "object",
      "properties": {
        "paso_1_bienvenida": {
          "type": "boolean",
          "default": false
        },
        "paso_2_datos_personales": {
          "type": "boolean",
          "default": false
        },
        "paso_3_documentos": {
          "type": "boolean",
          "default": false
        },
        "paso_4_configuracion_cuenta": {
          "type": "boolean",
          "default": false
        },
        "paso_5_asignacion_recursos": {
          "type": "boolean",
          "default": false
        },
        "paso_6_formacion_inicial": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "documentos_pendientes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string"
          },
          "requerido": {
            "type": "boolean"
          },
          "recibido": {
            "type": "boolean"
          },
          "fecha_recepcion": {
            "type": "string",
            "format": "date-time"
          },
          "archivo_url": {
            "type": "string"
          }
        }
      }
    },
    "recursos_asignados": {
      "type": "object",
      "properties": {
        "taquilla_asignada": {
          "type": "boolean",
          "default": false
        },
        "equipo_asignado": {
          "type": "boolean",
          "default": false
        },
        "accesos_sistemas": {
          "type": "boolean",
          "default": false
        },
        "formacion_seguridad": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "notificaciones_enviadas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string"
          },
          "fecha": {
            "type": "string",
            "format": "date-time"
          },
          "destinatario": {
            "type": "string"
          }
        }
      }
    },
    "responsable_onboarding": {
      "type": "string"
    },
    "notas": {
      "type": "string"
    },
    "porcentaje_completado": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "employee_id",
    "fecha_inicio"
  ]
}