{
  "name": "DepartmentIncentiveConfig",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "incentive_plan_id": {
      "type": "string",
      "description": "ID del plan de incentivos"
    },
    "departamento": {
      "type": "string",
      "description": "Nombre del departamento"
    },
    "puesto": {
      "type": "string",
      "description": "Puesto específico (opcional, si vacío aplica a todo el departamento)"
    },
    "empleados_aplicables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de empleados a los que aplica este plan (vacío = todos del puesto/departamento)"
    },
    "objetivos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "parametro": {
            "type": "string",
            "description": "Nombre del parámetro a medir"
          },
          "peso_porcentaje": {
            "type": "number",
            "description": "Peso del objetivo en porcentaje (0-100)"
          },
          "meta_objetivo": {
            "type": "number",
            "description": "Meta u objetivo a alcanzar"
          },
          "umbral_minimo": {
            "type": "number",
            "description": "Umbral mínimo para considerar cumplimiento"
          },
          "descripcion": {
            "type": "string"
          }
        }
      },
      "description": "Objetivos configurados (máximo 6)"
    },
    "incentivo_base": {
      "type": "number",
      "description": "Monto base del incentivo"
    },
    "formula_calculo": {
      "type": "string",
      "enum": [
        "Promedio Ponderado",
        "Cumplimiento Total",
        "Mínimo Requerido"
      ],
      "default": "Promedio Ponderado",
      "description": "Fórmula para calcular el incentivo"
    },
    "activo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "incentive_plan_id",
    "departamento",
    "objetivos"
  ]
}
