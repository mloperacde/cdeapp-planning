{
  "name": "AttendanceIncident",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh' or user.role == 'supervisor'}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "ID of the employee involved"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of the incident"
    },
    "type": {
      "type": "string",
      "enum": [
        "late_arrival",
        "early_exit",
        "unreported_absence",
        "presence_during_absence",
        "other"
      ],
      "description": "Type of discrepancy"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium",
      "description": "Severity level"
    },
    "description": {
      "type": "string",
      "description": "Auto-generated description of the issue"
    },
    "manager_comment": {
      "type": "string",
      "description": "Comment added by the manager"
    },
    "flagged_by": {
      "type": "string",
      "description": "ID of the user who flagged this"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "investigating",
        "resolved",
        "dismissed"
      ],
      "default": "open",
      "description": "Status of the incident"
    },
    "ai_analysis": {
      "type": "string",
      "description": "AI analysis of this specific incident if applicable"
    }
  },
  "required": [
    "employee_id",
    "date",
    "type"
  ]
}