{
  "name": "DailyProductionPlanning",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'jefe_turno'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'jefe_turno'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "fecha": {
      "type": "string",
      "format": "date",
      "description": "Fecha de la planificación"
    },
    "team_key": {
      "type": "string",
      "enum": [
        "team_1",
        "team_2"
      ],
      "description": "Equipo planificado"
    },
    "turno": {
      "type": "string",
      "enum": [
        "Mañana",
        "Tarde"
      ],
      "description": "Turno planificado"
    },
    "machine_id": {
      "type": "string",
      "description": "ID de la máquina"
    },
    "process_id": {
      "type": "string",
      "description": "ID del proceso"
    },
    "operadores_asignados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de operadores asignados"
    },
    "responsable_linea_id": {
      "type": "string",
      "description": "ID del responsable de línea"
    },
    "segunda_linea_id": {
      "type": "string",
      "description": "ID de la segunda de línea"
    },
    "articulo": {
      "type": "string",
      "description": "Artículo a producir"
    },
    "cantidad_objetivo": {
      "type": "number",
      "description": "Cantidad objetivo de producción"
    },
    "cantidad_real": {
      "type": "number",
      "description": "Cantidad real producida"
    },
    "notas": {
      "type": "string",
      "description": "Notas adicionales"
    },
    "estado": {
      "type": "string",
      "enum": [
        "Planificado",
        "En Curso",
        "Completado",
        "Cancelado"
      ],
      "default": "Planificado",
      "description": "Estado de la planificación"
    }
  },
  "required": [
    "fecha",
    "team_key",
    "turno",
    "machine_id"
  ]
}
