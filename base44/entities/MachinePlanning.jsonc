{
  "name": "MachinePlanning",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'jefe_turno'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'jefe_turno'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "machine_id": {
      "type": "string",
      "description": "ID de la m\u00e1quina"
    },
    "machine_nombre": {
      "type": "string",
      "description": "Nombre de la m\u00e1quina (desnormalizado)"
    },
    "machine_codigo": {
      "type": "string",
      "description": "C\u00f3digo de la m\u00e1quina (desnormalizado)"
    },
    "process_id": {
      "type": "string",
      "description": "ID del proceso seleccionado"
    },
    "team_key": {
      "type": "string",
      "enum": [
        "team_1",
        "team_2"
      ],
      "description": "Equipo para el que se planifica"
    },
    "turno": {
      "type": "string",
      "description": "Turno de la planificaci\u00f3n (Ma\u00f1ana o Tarde)"
    },
    "fecha_planificacion": {
      "type": "string",
      "format": "date",
      "description": "Fecha de la planificaci\u00f3n"
    },
    "activa_planning": {
      "type": "boolean",
      "default": false,
      "description": "Si la m\u00e1quina est\u00e1 activa en el planning"
    },
    "operadores_necesarios": {
      "type": "number",
      "description": "N\u00famero de operadores necesarios para este proceso"
    },
    "auto_suggested": {
      "type": "boolean",
      "default": false,
      "description": "Si fue sugerida autom\u00e1ticamente desde el Gantt"
    },
    "product_name": {
      "type": "string",
      "description": "Nombre del producto asociado (desde Gantt)"
    },
    "fecha_actualizacion": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de \u00faltima actualizaci\u00f3n"
    }
  },
  "required": [
    "machine_id",
    "team_key",
    "fecha_planificacion"
  ]
}