{
  "name": "MachinePlanning",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'jefe_turno'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'jefe_turno'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "machine_id": {
      "type": "string",
      "description": "ID de la máquina"
    },
    "machine_nombre": {
      "type": "string",
      "description": "Nombre de la máquina (desnormalizado)"
    },
    "machine_codigo": {
      "type": "string",
      "description": "Código de la máquina (desnormalizado)"
    },
    "process_id": {
      "type": "string",
      "description": "ID del proceso seleccionado"
    },
    "team_key": {
      "type": "string",
      "enum": [
        "team_1",
        "team_2"
      ],
      "description": "Equipo para el que se planifica"
    },
    "turno": {
      "type": "string",
      "description": "Turno de la planificación (Mañana o Tarde)"
    },
    "fecha_planificacion": {
      "type": "string",
      "format": "date",
      "description": "Fecha de la planificación"
    },
    "activa_planning": {
      "type": "boolean",
      "default": false,
      "description": "Si la máquina está activa en el planning"
    },
    "operadores_necesarios": {
      "type": "number",
      "description": "Número de operadores necesarios para este proceso"
    },
    "auto_suggested": {
      "type": "boolean",
      "default": false,
      "description": "Si fue sugerida automáticamente desde el Gantt"
    },
    "product_name": {
      "type": "string",
      "description": "Nombre del producto asociado (desde Gantt)"
    },
    "fecha_actualizacion": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de última actualización"
    }
  },
  "required": [
    "machine_id",
    "team_key",
    "fecha_planificacion"
  ]
}
