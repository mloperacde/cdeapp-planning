{
  "name": "AbsenceType",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "nombre": {
      "type": "string"
    },
    "codigo": {
      "type": "string"
    },
    "categoria_principal": {
      "type": "string",
      "enum": [
        "Permiso",
        "Baja Laboral"
      ]
    },
    "subcategoria": {
      "type": "string",
      "enum": [
        "Permiso Remunerado",
        "Permiso No Remunerado",
        "Baja por Enfermedad Com\u00fan",
        "Baja por Accidente No Laboral",
        "Baja por Enfermedad Profesional",
        "Baja por Accidente Laboral",
        "Baja por Maternidad",
        "Baja por Paternidad",
        "Baja por Riesgo Durante Embarazo",
        "Baja por Riesgo Durante Lactancia"
      ]
    },
    "remunerada": {
      "type": "boolean",
      "default": false
    },
    "no_consume_vacaciones": {
      "type": "boolean",
      "default": true
    },
    "requiere_aprobacion": {
      "type": "boolean",
      "default": true
    },
    "hecho_causante": {
      "type": "string"
    },
    "duracion_dias": {
      "type": "number"
    },
    "duracion_semanas": {
      "type": "number"
    },
    "duracion_descripcion": {
      "type": "string"
    },
    "ampliacion_desplazamiento": {
      "type": "boolean",
      "default": false
    },
    "dias_ampliacion": {
      "type": "number"
    },
    "inicio_disfrute": {
      "type": "string"
    },
    "consideraciones": {
      "type": "string"
    },
    "articulo_referencia": {
      "type": "string"
    },
    "es_critica": {
      "type": "boolean",
      "default": false
    },
    "notificar_admin": {
      "type": "boolean",
      "default": false
    },
    "dias_aviso_previo": {
      "type": "number",
      "default": 0
    },
    "requiere_documentacion": {
      "type": "boolean",
      "default": false
    },
    "cotizacion_ss": {
      "type": "boolean",
      "default": false
    },
    "prestacion_ss": {
      "type": "boolean",
      "default": false
    },
    "porcentaje_prestacion": {
      "type": "number"
    },
    "carencia_dias": {
      "type": "number"
    },
    "color": {
      "type": "string"
    },
    "descripcion": {
      "type": "string"
    },
    "activo": {
      "type": "boolean",
      "default": true
    },
    "orden": {
      "type": "number"
    },
    "visible_empleados": {
      "type": "boolean",
      "default": true
    },
    "permite_acumulacion": {
      "type": "boolean",
      "default": false
    },
    "dias_maximos_acumulacion": {
      "type": "number"
    },
    "caducidad_dias_acumulados": {
      "type": "number",
      "default": 365
    },
    "requiere_aprobacion_acumulacion": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "nombre",
    "codigo",
    "categoria_principal",
    "subcategoria"
  ]
}