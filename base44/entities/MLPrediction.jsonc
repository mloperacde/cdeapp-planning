{
  "name": "MLPrediction",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh' or user.role == 'supervisor'}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "tipo_prediccion": {
      "type": "string",
      "enum": [
        "Rotaci\u00f3n Empleado",
        "Optimizaci\u00f3n Turnos",
        "Cuello Botella M\u00e1quina"
      ]
    },
    "employee_id": {
      "type": "string"
    },
    "machine_id": {
      "type": "string"
    },
    "fecha_prediccion": {
      "type": "string",
      "format": "date-time"
    },
    "probabilidad": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "nivel_riesgo": {
      "type": "string",
      "enum": [
        "Bajo",
        "Medio",
        "Alto",
        "Cr\u00edtico"
      ]
    },
    "factores_contribuyentes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "datos_analisis": {
      "type": "object"
    },
    "recomendaciones": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "optimizacion_turnos": {
      "type": "object"
    },
    "cuello_botella": {
      "type": "object"
    },
    "activo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "tipo_prediccion",
    "fecha_prediccion",
    "probabilidad",
    "nivel_riesgo"
  ]
}