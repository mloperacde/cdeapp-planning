{
  "name": "MobileAbsenceRequest",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh' or user.employee_id == employee_id}}"
    },
    {
      "operation": "create",
      "allow": "{{user.employee_id == employee_id or user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh' or (user.employee_id == employee_id and estado == 'Pendiente')}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "fecha_inicio": {
      "type": "string",
      "format": "date-time"
    },
    "fecha_fin": {
      "type": "string",
      "format": "date-time"
    },
    "motivo": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Vacaciones",
        "Baja m\u00e9dica",
        "Permiso",
        "Ausencia justificada",
        "Ausencia injustificada",
        "Otro"
      ]
    },
    "notas": {
      "type": "string"
    },
    "documentos_adjuntos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estado": {
      "type": "string",
      "enum": [
        "Pendiente",
        "Aprobada",
        "Rechazada"
      ],
      "default": "Pendiente"
    },
    "revisado_por": {
      "type": "string"
    },
    "fecha_revision": {
      "type": "string",
      "format": "date-time"
    },
    "comentarios_revision": {
      "type": "string"
    },
    "fecha_solicitud": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "employee_id",
    "fecha_inicio",
    "fecha_fin",
    "motivo",
    "tipo"
  ]
}