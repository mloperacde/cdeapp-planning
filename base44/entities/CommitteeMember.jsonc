{
  "name": "CommitteeMember",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh' or user.role == 'supervisor' or user.employee_id == employee_id}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "tipos_comite": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cargo": {
      "type": "string"
    },
    "fecha_inicio": {
      "type": "string",
      "format": "date"
    },
    "fecha_fin": {
      "type": "string",
      "format": "date"
    },
    "activo": {
      "type": "boolean",
      "default": true
    },
    "horas_sindicales_mensuales": {
      "type": "number",
      "default": 0
    },
    "horas_sindicales_consumidas_mes_actual": {
      "type": "number",
      "default": 0
    },
    "ultimo_reset_horas_sindicales": {
      "type": "string",
      "format": "date"
    },
    "funciones": {
      "type": "string"
    },
    "formacion_especifica": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "contacto_emergencia_comite": {
      "type": "string"
    },
    "notas": {
      "type": "string"
    }
  },
  "required": [
    "employee_id",
    "tipos_comite",
    "fecha_inicio"
  ]
}