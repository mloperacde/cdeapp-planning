{
  "name": "ShiftSwapRequest",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'supervisor' or user.employee_id == solicitante_id or user.employee_id == receptor_id}}"
    },
    {
      "operation": "create",
      "allow": "{{user.employee_id == solicitante_id or user.role == 'admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'supervisor' or user.employee_id == solicitante_id or user.employee_id == receptor_id}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "solicitante_id": {
      "type": "string"
    },
    "nombre_solicitante": {
      "type": "string"
    },
    "equipo_solicitante": {
      "type": "string"
    },
    "fecha_cambio": {
      "type": "string",
      "format": "date"
    },
    "turno_actual": {
      "type": "string",
      "enum": [
        "Ma\u00f1ana",
        "Tarde",
        "Noche"
      ]
    },
    "turno_deseado": {
      "type": "string",
      "enum": [
        "Ma\u00f1ana",
        "Tarde",
        "Noche"
      ]
    },
    "interesados": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "receptor_id": {
      "type": "string"
    },
    "nombre_receptor": {
      "type": "string"
    },
    "motivo": {
      "type": "string"
    },
    "estado": {
      "type": "string",
      "enum": [
        "Publicado",
        "Pendiente Aprobaci\u00f3n",
        "Aprobada",
        "Rechazada",
        "Cancelada"
      ],
      "default": "Publicado"
    },
    "fecha_solicitud": {
      "type": "string",
      "format": "date-time"
    },
    "fecha_respuesta_supervisor": {
      "type": "string",
      "format": "date-time"
    },
    "supervisor_id": {
      "type": "string"
    },
    "comentarios_supervisor": {
      "type": "string"
    }
  },
  "required": [
    "solicitante_id",
    "fecha_cambio",
    "turno_actual",
    "turno_deseado"
  ]
}