{
  "name": "EmployeeMasterDatabase",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh' or (user.role == 'supervisor' and user.department_id == department_id) or user.employee_id == id}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh' or (user.employee_id == id and (field == 'email' or field == 'telefono_movil' or field == 'direccion'))}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "codigo_empleado": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico del empleado"
    },
    "nombre": {
      "type": "string",
      "description": "Nombre completo del empleado"
    },
    "estado_empleado": {
      "type": "string",
      "enum": [
        "Alta",
        "Baja"
      ],
      "default": "Alta"
    },
    "fecha_baja": {
      "type": "string",
      "format": "date"
    },
    "motivo_baja": {
      "type": "string"
    },
    "sujeto_a_control_horario": {
      "type": "boolean",
      "default": true
    },
    "tasa_absentismo": {
      "type": "number"
    },
    "horas_no_trabajadas": {
      "type": "number",
      "default": 0
    },
    "horas_deberian_trabajarse": {
      "type": "number",
      "default": 0
    },
    "ultima_actualizacion_absentismo": {
      "type": "string",
      "format": "date"
    },
    "fecha_nacimiento": {
      "type": "string",
      "format": "date"
    },
    "dni": {
      "type": "string"
    },
    "nuss": {
      "type": "string"
    },
    "sexo": {
      "type": "string",
      "enum": [
        "Masculino",
        "Femenino",
        "Otro"
      ]
    },
    "nacionalidad": {
      "type": "string"
    },
    "direccion": {
      "type": "string"
    },
    "formacion": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "telefono_movil": {
      "type": "string"
    },
    "contacto_emergencia_nombre": {
      "type": "string"
    },
    "contacto_emergencia_telefono": {
      "type": "string"
    },
    "contacto_emergencia_relacion": {
      "type": "string"
    },
    "iban": {
      "type": "string"
    },
    "swift_bic": {
      "type": "string"
    },
    "banco_nombre": {
      "type": "string"
    },
    "departamento": {
      "type": "string"
    },
    "department_id": {
      "type": "string"
    },
    "puesto": {
      "type": "string"
    },
    "categoria": {
      "type": "string"
    },
    "tipo_jornada": {
      "type": "string",
      "enum": [
        "Jornada Completa",
        "Jornada Parcial",
        "Reducci\u00f3n de Jornada"
      ]
    },
    "num_horas_jornada": {
      "type": "number"
    },
    "tipo_turno": {
      "type": "string",
      "enum": [
        "Rotativo",
        "Fijo Ma\u00f1ana",
        "Fijo Tarde",
        "Turno Partido"
      ]
    },
    "equipo": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "team_key": {
      "type": "string",
      "enum": [
        "team_1",
        "team_2"
      ]
    },
    "team_fixed": {
      "type": "boolean",
      "default": false
    },
    "horario_manana_inicio": {
      "type": "string"
    },
    "horario_manana_fin": {
      "type": "string"
    },
    "horario_tarde_inicio": {
      "type": "string"
    },
    "horario_tarde_fin": {
      "type": "string"
    },
    "turno_partido_entrada1": {
      "type": "string"
    },
    "turno_partido_salida1": {
      "type": "string"
    },
    "turno_partido_entrada2": {
      "type": "string"
    },
    "turno_partido_salida2": {
      "type": "string"
    },
    "taquilla_vestuario": {
      "type": "string"
    },
    "taquilla_numero": {
      "type": "string"
    },
    "disponibilidad": {
      "type": "string",
      "enum": [
        "Disponible",
        "Ausente"
      ],
      "default": "Disponible"
    },
    "estado_presencia": {
      "type": "string",
      "enum": [
        "Presente",
        "Potencialmente Ausente",
        "Retraso",
        "Ausente Auto",
        "Ausente",
        "No Aplica"
      ],
      "default": "No Aplica"
    },
    "potencialmente_ausente_desde": {
      "type": "string",
      "format": "date-time"
    },
    "ausencia_inicio": {
      "type": "string",
      "format": "date-time"
    },
    "ausencia_fin": {
      "type": "string",
      "format": "date-time"
    },
    "ausencia_motivo": {
      "type": "string"
    },
    "incluir_en_planning": {
      "type": "boolean",
      "default": true
    },
    "fecha_alta": {
      "type": "string",
      "format": "date"
    },
    "tipo_contrato": {
      "type": "string"
    },
    "codigo_contrato": {
      "type": "string"
    },
    "fecha_fin_contrato": {
      "type": "string",
      "format": "date"
    },
    "empresa_ett": {
      "type": "string"
    },
    "salario_anual": {
      "type": "number"
    },
    "evaluacion_responsable": {
      "type": "string"
    },
    "propuesta_cambio_categoria": {
      "type": "string",
      "enum": [
        "1",
        "2",
        "3"
      ]
    },
    "propuesta_cambio_quien": {
      "type": "string"
    },
    "horas_causa_mayor_consumidas": {
      "type": "number",
      "default": 0
    },
    "horas_causa_mayor_limite": {
      "type": "number"
    },
    "ultimo_reset_causa_mayor": {
      "type": "string",
      "format": "date"
    },
    "maquina_1": {
      "type": "string"
    },
    "maquina_2": {
      "type": "string"
    },
    "maquina_3": {
      "type": "string"
    },
    "maquina_4": {
      "type": "string"
    },
    "maquina_5": {
      "type": "string"
    },
    "maquina_6": {
      "type": "string"
    },
    "maquina_7": {
      "type": "string"
    },
    "maquina_8": {
      "type": "string"
    },
    "maquina_9": {
      "type": "string"
    },
    "maquina_10": {
      "type": "string"
    },
    "legacy_employee_id": {
      "type": "string"
    },
    "ultimo_sincronizado": {
      "type": "string",
      "format": "date-time"
    },
    "estado_sincronizacion": {
      "type": "string",
      "enum": [
        "Sincronizado",
        "Pendiente",
        "Error"
      ],
      "default": "Pendiente"
    },
    "pin": {
      "type": "integer"
    },
    "numero_tarjeta": {
      "type": "string"
    }
  },
  "required": [
    "nombre"
  ]
}