{
  "name": "EmployeeSyncHistory",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{true}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "master_employee_id": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "sync_date": {
      "type": "string",
      "format": "date-time"
    },
    "sync_type": {
      "type": "string",
      "enum": [
        "Creación",
        "Actualización",
        "Sincronización Total",
        "Sincronización Parcial",
        "Sincronización Automática",
        "Deshacer Sincronización"
      ]
    },
    "fields_synced": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changes_detected": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "Exitoso",
        "Error"
      ],
      "default": "Exitoso"
    },
    "error_message": {
      "type": "string"
    },
    "synced_by": {
      "type": "string"
    },
    "sync_rule_applied": {
      "type": "string"
    }
  },
  "required": [
    "master_employee_id",
    "sync_date",
    "sync_type"
  ]
}
