{
  "name": "EmployeeSyncHistory",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "master_employee_id": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "sync_date": {
      "type": "string",
      "format": "date-time"
    },
    "sync_type": {
      "type": "string",
      "enum": [
        "Creaci\u00f3n",
        "Actualizaci\u00f3n",
        "Sincronizaci\u00f3n Total",
        "Sincronizaci\u00f3n Parcial",
        "Sincronizaci\u00f3n Autom\u00e1tica",
        "Deshacer Sincronizaci\u00f3n"
      ]
    },
    "fields_synced": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changes_detected": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "Exitoso",
        "Error"
      ],
      "default": "Exitoso"
    },
    "error_message": {
      "type": "string"
    },
    "synced_by": {
      "type": "string"
    },
    "sync_rule_applied": {
      "type": "string"
    }
  },
  "required": [
    "master_employee_id",
    "sync_date",
    "sync_type"
  ]
}