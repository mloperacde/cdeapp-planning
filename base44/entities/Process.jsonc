{
  "name": "Process",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "nombre": {
      "type": "string"
    },
    "codigo": {
      "type": "string"
    },
    "descripcion": {
      "type": "string"
    },
    "operadores_requeridos": {
      "type": "number",
      "default": 1
    },
    "activo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "nombre",
    "codigo"
  ]
}
