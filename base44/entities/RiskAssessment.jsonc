{
  "name": "RiskAssessment",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "codigo": {
      "type": "string"
    },
    "titulo": {
      "type": "string"
    },
    "departamento": {
      "type": "string"
    },
    "puesto": {
      "type": "string"
    },
    "area": {
      "type": "string"
    },
    "fecha_evaluacion": {
      "type": "string",
      "format": "date"
    },
    "fecha_revision": {
      "type": "string",
      "format": "date"
    },
    "evaluador_id": {
      "type": "string"
    },
    "riesgos_identificados": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "plan_accion": {
      "type": "string"
    },
    "estado_general": {
      "type": "string",
      "enum": [
        "En Proceso",
        "Completada",
        "Revisión Pendiente"
      ],
      "default": "En Proceso"
    },
    "documento_url": {
      "type": "string"
    },
    "notas": {
      "type": "string"
    }
  },
  "required": [
    "titulo",
    "fecha_evaluacion"
  ]
}
