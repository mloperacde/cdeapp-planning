{
  "name": "MachineAssignmentAudit",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{true}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "machine_id": {
      "type": "string",
      "description": "ID de la máquina afectada"
    },
    "machine_name": {
      "type": "string",
      "description": "Nombre de la máquina (para referencia histórica)"
    },
    "team_key": {
      "type": "string",
      "description": "Clave del equipo (ej: team_1)"
    },
    "action": {
      "type": "string",
      "enum": [
        "create",
        "update"
      ],
      "description": "Tipo de acción"
    },
    "changes": {
      "type": "string",
      "description": "Descripción JSON stringified de los cambios (antiguo -> nuevo)"
    },
    "modified_by": {
      "type": "string",
      "description": "Email del usuario que realizó el cambio"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora del cambio"
    }
  },
  "required": [
    "machine_id",
    "action",
    "modified_by",
    "timestamp"
  ]
}
