{
  "name": "TrainingAssignment",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh' or user.employee_id == employeeId}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "employeeId": {
      "type": "string"
    },
    "employeeName": {
      "type": "string"
    },
    "employeeDepartamento": {
      "type": "string"
    },
    "employeePuesto": {
      "type": "string"
    },
    "trainingModuleId": {
      "type": "string"
    },
    "trainingModuleTitulo": {
      "type": "string"
    },
    "fechaAsignacion": {
      "type": "string",
      "format": "date"
    },
    "fechaLimite": {
      "type": "string",
      "format": "date"
    },
    "fechaInicio": {
      "type": "string",
      "format": "date"
    },
    "fechaCompletado": {
      "type": "string",
      "format": "date"
    },
    "estado": {
      "type": "string",
      "enum": [
        "Asignado",
        "En Progreso",
        "Completado",
        "Vencido",
        "Cancelado"
      ],
      "default": "Asignado"
    },
    "puntuacion": {
      "type": "number"
    },
    "superado": {
      "type": "boolean"
    },
    "notasFormador": {
      "type": "string"
    },
    "firmaEmpleado": {
      "type": "boolean",
      "default": false
    },
    "asignadoPor": {
      "type": "string"
    }
  },
  "required": [
    "employeeId",
    "trainingModuleId",
    "fechaAsignacion",
    "estado"
  ]
}