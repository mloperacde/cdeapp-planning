{
  "name": "AttendanceConfig",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "nombre_configuracion": {
      "type": "string",
      "default": "Configuraci\u00f3n General"
    },
    "tolerancia_entrada_minutos": {
      "type": "number",
      "default": 10
    },
    "tolerancia_salida_minutos": {
      "type": "number",
      "default": 10
    },
    "marcar_ausente_despues_de_minutos": {
      "type": "number",
      "default": 60
    },
    "auto_actualizar_disponibilidad": {
      "type": "boolean",
      "default": true
    },
    "crear_ausencia_automatica": {
      "type": "boolean",
      "default": true
    },
    "notificar_ausencias": {
      "type": "boolean",
      "default": true
    },
    "notificar_retrasos": {
      "type": "boolean",
      "default": true
    },
    "notificar_retrasos_solo_si_mas_de_minutos": {
      "type": "number",
      "default": 15
    },
    "destinatarios_notificaciones": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "departamentos_estrictos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tolerancia_reducida_minutos": {
      "type": "number",
      "default": 5
    },
    "activar_predicciones_ml": {
      "type": "boolean",
      "default": true
    },
    "umbral_alertas_patron_retrasos": {
      "type": "number",
      "default": 3
    },
    "activo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "nombre_configuracion"
  ]
}