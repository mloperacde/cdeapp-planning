{
  "name": "Article",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "code": {
      "type": "string",
      "description": "C\u00f3digo del art\u00edculo"
    },
    "name": {
      "type": "string",
      "description": "Nombre del art\u00edculo"
    },
    "description": {
      "type": "string"
    },
    "client": {
      "type": "string"
    },
    "reference": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "process_code": {
      "type": "string"
    },
    "operators_required": {
      "type": "integer",
      "default": 1
    },
    "total_time_seconds": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "status_article": {
      "type": "string",
      "default": "PENDIENTE"
    },
    "injet": {
      "type": "boolean",
      "default": false
    },
    "laser": {
      "type": "boolean",
      "default": false
    },
    "etiquetado": {
      "type": "boolean",
      "default": false
    },
    "celo": {
      "type": "boolean",
      "default": false
    },
    "unid_box": {
      "type": "integer",
      "default": 0
    },
    "unid_pallet": {
      "type": "integer",
      "default": 0
    },
    "multi_unid": {
      "type": "integer",
      "default": 1
    },
    "cde_id": {
      "type": "integer",
      "description": "ID del art\u00edculo en CDEApp (para enlazar con ArticleComponent)"
    },
    "selected_activities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "code",
    "name"
  ]
}