{
  "name": "CompensationPolicy",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{true}}"
    },
    {
      "operation": "update",
      "allow": "{{true}}"
    },
    {
      "operation": "delete",
      "allow": "{{true}}"
    }
  ],
  "properties": {
    "policy_name": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "applies_to": {
      "type": "string",
      "enum": [
        "Todos",
        "Por Departamento",
        "Por Puesto",
        "Por Categoría",
        "Personalizado"
      ],
      "default": "Todos"
    },
    "target_departments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_positions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "salary_components": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "salary_ranges": {
      "type": "object"
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "valid_to": {
      "type": "string",
      "format": "date"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "auto_apply": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "policy_name",
    "code",
    "valid_from"
  ]
}
