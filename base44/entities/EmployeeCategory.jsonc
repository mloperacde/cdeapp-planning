{
  "name": "EmployeeCategory",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "ID del empleado"
    },
    "employee_name": {
      "type": "string",
      "description": "Nombre del empleado"
    },
    "category_id": {
      "type": "string",
      "description": "ID de la categoría salarial"
    },
    "category_name": {
      "type": "string",
      "description": "Nombre de la categoría"
    },
    "category_level": {
      "type": "number",
      "description": "Nivel de la categoría"
    },
    "assigned_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de asignación"
    },
    "effective_from": {
      "type": "string",
      "format": "date",
      "description": "Fecha efectiva de inicio"
    },
    "effective_to": {
      "type": "string",
      "format": "date",
      "description": "Fecha de fin (para histórico)"
    },
    "is_current": {
      "type": "boolean",
      "default": true,
      "description": "Si es la categoría actual"
    },
    "reason": {
      "type": "string",
      "description": "Motivo de la asignación o cambio"
    },
    "approved_by": {
      "type": "string",
      "description": "Usuario que aprobó"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
  "required": [
    "employee_id",
    "category_id",
    "assigned_date"
  ]
}
