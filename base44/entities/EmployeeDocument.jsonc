{
  "name": "EmployeeDocument",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{true}}"
    },
    {
      "operation": "update",
      "allow": "{{true}}"
    },
    {
      "operation": "delete",
      "allow": "{{true}}"
    }
  ],
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "ID del empleado"
    },
    "titulo": {
      "type": "string",
      "description": "Título del documento"
    },
    "tipo_documento": {
      "type": "string",
      "enum": [
        "Contrato",
        "Evaluación",
        "Certificado",
        "Formación",
        "Plan de Mejora",
        "Informe Disciplinario",
        "Otro"
      ],
      "description": "Tipo de documento"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripción del documento"
    },
    "file_url": {
      "type": "string",
      "description": "URL del archivo adjunto"
    },
    "fecha_documento": {
      "type": "string",
      "format": "date",
      "description": "Fecha del documento"
    },
    "fecha_vencimiento": {
      "type": "string",
      "format": "date",
      "description": "Fecha de vencimiento (si aplica)"
    },
    "confidencial": {
      "type": "boolean",
      "default": false,
      "description": "Si el documento es confidencial"
    },
    "notas": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
  "required": [
    "employee_id",
    "titulo",
    "tipo_documento"
  ]
}
