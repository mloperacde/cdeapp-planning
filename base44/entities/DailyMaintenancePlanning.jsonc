{
  "name": "DailyMaintenancePlanning",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'T\u00e9cnico'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'T\u00e9cnico'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "fecha": {
      "type": "string",
      "format": "date",
      "description": "Fecha de la planificaci\u00f3n"
    },
    "team_key": {
      "type": "string",
      "enum": [
        "team_1",
        "team_2"
      ],
      "description": "Equipo planificado"
    },
    "turno": {
      "type": "string",
      "enum": [
        "Ma\u00f1ana",
        "Tarde"
      ],
      "description": "Turno planificado"
    },
    "employee_id": {
      "type": "string",
      "description": "ID del empleado de mantenimiento"
    },
    "funcion_asignada": {
      "type": "string",
      "description": "Funci\u00f3n o tarea asignada"
    },
    "area_responsabilidad": {
      "type": "string",
      "description": "\u00c1rea de responsabilidad"
    },
    "prioridad": {
      "type": "string",
      "enum": [
        "Baja",
        "Media",
        "Alta",
        "Urgente"
      ],
      "default": "Media",
      "description": "Prioridad de la funci\u00f3n"
    },
    "maquinas_asignadas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de m\u00e1quinas asignadas"
    },
    "notas": {
      "type": "string",
      "description": "Notas adicionales"
    },
    "estado": {
      "type": "string",
      "enum": [
        "Planificado",
        "En Curso",
        "Completado",
        "Cancelado"
      ],
      "default": "Planificado",
      "description": "Estado de la planificaci\u00f3n"
    },
    "hora_inicio": {
      "type": "string",
      "description": "Hora de inicio estimada"
    },
    "hora_fin": {
      "type": "string",
      "description": "Hora de fin estimada"
    }
  },
  "required": [
    "fecha",
    "team_key",
    "turno",
    "employee_id",
    "funcion_asignada"
  ]
}