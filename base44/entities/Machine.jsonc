{
  "name": "Machine",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "nombre": {
      "type": "string",
      "description": "Nombre de la m\u00e1quina"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo identificador de la m\u00e1quina"
    },
    "marca": {
      "type": "string"
    },
    "modelo": {
      "type": "string"
    },
    "numero_serie": {
      "type": "string"
    },
    "fecha_compra": {
      "type": "string",
      "format": "date"
    },
    "tipo": {
      "type": "string"
    },
    "ubicacion": {
      "type": "string"
    },
    "descripcion": {
      "type": "string"
    },
    "orden": {
      "type": "number"
    },
    "programa_mantenimiento": {
      "type": "string"
    },
    "procesos_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "articulos_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parametros_sobres": {
      "type": "object",
      "properties": {
        "ancho_paso_minimo": {
          "type": "number"
        },
        "ancho_paso_maximo": {
          "type": "number"
        },
        "dosis_minima": {
          "type": "number"
        },
        "dosis_maxima": {
          "type": "number"
        },
        "cargador": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "parametros_frascos": {
      "type": "object",
      "properties": {
        "dosis_minima": {
          "type": "number"
        },
        "dosis_maxima": {
          "type": "number"
        },
        "roscado": {
          "type": "boolean",
          "default": false
        },
        "grafado": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "imagenes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "archivos_adjuntos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          },
          "fecha_subida": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "historico_articulos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "articulo": {
            "type": "string"
          },
          "fecha": {
            "type": "string",
            "format": "date-time"
          },
          "cantidad": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "nombre",
    "codigo"
  ]
}