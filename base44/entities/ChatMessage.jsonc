{
  "name": "ChatMessage",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.id == sender_id}}"
    },
    {
      "operation": "create",
      "allow": "{{user.id == sender_id}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.id == sender_id}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.id == sender_id}}"
    }
  ],
  "properties": {
    "channel_id": {
      "type": "string"
    },
    "sender_id": {
      "type": "string"
    },
    "mensaje": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "texto",
        "archivo",
        "imagen",
        "sistema"
      ],
      "default": "texto"
    },
    "archivo_url": {
      "type": "string"
    },
    "leido_por": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "fecha_envio": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "channel_id",
    "sender_id",
    "mensaje"
  ]
}