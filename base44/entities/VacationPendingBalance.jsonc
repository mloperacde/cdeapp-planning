{
  "name": "VacationPendingBalance",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh' or user.employee_id == employee_id}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "anio": {
      "type": "number"
    },
    "dias_pendientes": {
      "type": "number",
      "default": 0
    },
    "detalle_ausencias": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dias_consumidos": {
      "type": "number",
      "default": 0
    },
    "dias_disponibles": {
      "type": "number"
    },
    "observaciones": {
      "type": "string"
    }
  },
  "required": [
    "employee_id",
    "anio"
  ]
}