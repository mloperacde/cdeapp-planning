{
  "name": "BreakShift",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'jefe_turno'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'jefe_turno'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "nombre": {
      "type": "string"
    },
    "hora_inicio": {
      "type": "string"
    },
    "duracion_minutos": {
      "type": "number",
      "default": 20
    },
    "personas_por_turno": {
      "type": "number"
    },
    "aplica_turno_manana": {
      "type": "boolean",
      "default": true
    },
    "aplica_turno_tarde": {
      "type": "boolean",
      "default": true
    },
    "activo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "nombre",
    "hora_inicio",
    "personas_por_turno"
  ]
}