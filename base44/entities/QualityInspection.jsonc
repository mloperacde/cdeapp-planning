{
  "name": "QualityInspection",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'T\u00e9cnico' or user.role == 'supervisor'}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'T\u00e9cnico'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'T\u00e9cnico'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "work_order_id": {
      "type": "string"
    },
    "product_article_code": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "inspection_date": {
      "type": "string",
      "format": "date-time"
    },
    "inspector_id": {
      "type": "string"
    },
    "inspector_name": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "Aprobado",
        "Rechazado",
        "Aprobado con Observaciones"
      ]
    },
    "defects_found": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quantity_inspected": {
      "type": "number"
    },
    "quantity_approved": {
      "type": "number"
    },
    "quantity_rejected": {
      "type": "number"
    },
    "comments": {
      "type": "string"
    },
    "rework_required": {
      "type": "boolean",
      "default": false
    },
    "rework_assigned_to": {
      "type": "string"
    },
    "rework_completed": {
      "type": "boolean",
      "default": false
    },
    "rework_completion_date": {
      "type": "string",
      "format": "date-time"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "machine_id": {
      "type": "string"
    },
    "machine_name": {
      "type": "string"
    },
    "team_key": {
      "type": "string"
    },
    "responsable_linea": {
      "type": "string"
    },
    "responsable_linea_name": {
      "type": "string"
    },
    "segunda_linea": {
      "type": "string"
    },
    "segunda_linea_name": {
      "type": "string"
    },
    "operarios": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "severity": {
      "type": "string",
      "enum": [
        "Baja",
        "Media",
        "Alta",
        "Cr\u00edtica"
      ],
      "default": "Media"
    }
  },
  "required": [
    "inspection_date",
    "inspector_id",
    "result"
  ]
}