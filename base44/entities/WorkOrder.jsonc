{
  "name": "WorkOrder",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'jefe_turno'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "order_number": {
      "type": "string"
    },
    "machine_id": {
      "type": "string"
    },
    "process_id": {
      "type": "string"
    },
    "priority": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "committed_delivery_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pendiente",
        "En Progreso",
        "Completada",
        "Retrasada",
        "Cancelada"
      ],
      "default": "Pendiente"
    },
    "notes": {
      "type": "string"
    },
    "customer_order_reference": {
      "type": "string"
    },
    "external_order_reference": {
      "type": "string"
    },
    "product_article_code": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "material_type": {
      "type": "string"
    },
    "product_category": {
      "type": "string"
    },
    "missing_components_flag": {
      "type": "boolean",
      "default": false
    },
    "production_cadence": {
      "type": "number"
    },
    "has_customer_delay_note": {
      "type": "boolean",
      "default": false
    },
    "machine_location": {
      "type": "string"
    },
    "estimated_duration": {
      "type": "number"
    },
    "planned_end_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "order_number",
    "machine_id",
    "priority",
    "status"
  ]
}