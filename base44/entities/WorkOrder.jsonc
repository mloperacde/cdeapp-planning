{
  "name": "WorkOrder",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'jefe_turno'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "order_number": {
      "type": "string"
    },
    "machine_id": {
      "type": "string"
    },
    "process_id": {
      "type": "string"
    },
    "priority": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "committed_delivery_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pendiente",
        "En Progreso",
        "Completada",
        "Retrasada",
        "Cancelada"
      ],
      "default": "Pendiente"
    },
    "notes": {
      "type": "string"
    },
    "customer_order_reference": {
      "type": "string"
    },
    "external_order_reference": {
      "type": "string"
    },
    "product_article_code": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "material_type": {
      "type": "string"
    },
    "product_category": {
      "type": "string"
    },
    "missing_components_flag": {
      "type": "boolean",
      "default": false
    },
    "production_cadence": {
      "type": "number"
    },
    "has_customer_delay_note": {
      "type": "boolean",
      "default": false
    },
    "machine_location": {
      "type": "string"
    },
    "estimated_duration": {
      "type": "number"
    },
    "planned_end_date": {
      "type": "string",
      "format": "date"
    },
    "personal_requerido": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actividad": {
            "type": "string",
            "description": "Nombre de la actividad/etapa (ej: Llenado, Etiquetado, Proceso Completo)"
          },
          "cantidad_operarios": {
            "type": "number",
            "description": "N\u00famero de operarios necesarios para esta actividad"
          },
          "notas": {
            "type": "string",
            "description": "Notas adicionales sobre la necesidad de personal"
          }
        }
      },
      "description": "Configuraci\u00f3n de operarios necesarios por orden de trabajo (definida por orden, no por art\u00edculo)"
    },
    "operadores_requeridos": {
      "type": "number",
      "description": "Total de operarios requeridos para esta orden (suma de personal_requerido o valor manual)"
    }
  },
  "required": [
    "order_number",
    "machine_id",
    "priority",
    "status"
  ]
}