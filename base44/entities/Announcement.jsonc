{
  "name": "Announcement",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{true}}"
    },
    {
      "operation": "update",
      "allow": "{{true}}"
    },
    {
      "operation": "delete",
      "allow": "{{true}}"
    }
  ],
  "properties": {
    "titulo": {
      "type": "string"
    },
    "contenido": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Informativo",
        "Urgente",
        "Recordatorio",
        "Evento"
      ],
      "default": "Informativo"
    },
    "activo": {
      "type": "boolean",
      "default": true
    },
    "fecha_expiracion": {
      "type": "string",
      "format": "date"
    },
    "autor_nombre": {
      "type": "string"
    }
  },
  "required": [
    "titulo",
    "contenido"
  ]
}
