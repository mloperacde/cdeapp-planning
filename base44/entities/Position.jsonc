{
  "name": "Position",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "department_id": {
      "type": "string"
    },
    "department_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "max_headcount": {
      "type": "number",
      "default": 1
    },
    "requirements": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": [
        "Junior",
        "Mid",
        "Senior",
        "Lead",
        "Manager",
        "Director",
        "Executive"
      ],
      "default": "Mid"
    },
    "reports_to_position_id": {
      "type": "string"
    },
    "orden": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "department_id"
  ]
}
