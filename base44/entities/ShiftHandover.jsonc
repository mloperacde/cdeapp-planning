{
  "name": "ShiftHandover",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'jefe_turno'}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'jefe_turno'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'jefe_turno'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "fecha": {
      "type": "string",
      "format": "date"
    },
    "turno_saliente": {
      "type": "string",
      "enum": [
        "Mañana",
        "Tarde",
        "Noche"
      ]
    },
    "turno_entrante": {
      "type": "string",
      "enum": [
        "Mañana",
        "Tarde",
        "Noche"
      ]
    },
    "jefe_turno_saliente": {
      "type": "string"
    },
    "jefe_turno_entrante": {
      "type": "string"
    },
    "observaciones_maquinas": {
      "type": "object"
    },
    "otras_indicaciones": {
      "type": "string"
    }
  },
  "required": [
    "fecha",
    "turno_saliente",
    "turno_entrante"
  ]
}
