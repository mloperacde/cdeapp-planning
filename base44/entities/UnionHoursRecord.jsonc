{
  "name": "UnionHoursRecord",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "committee_member_id": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "fecha": {
      "type": "string",
      "format": "date"
    },
    "horas_utilizadas": {
      "type": "number"
    },
    "motivo": {
      "type": "string"
    },
    "actividad": {
      "type": "string",
      "enum": [
        "Reuni\u00f3n Comit\u00e9",
        "Negociaci\u00f3n Colectiva",
        "Asesoramiento Trabajadores",
        "Formaci\u00f3n Sindical",
        "Otro"
      ]
    },
    "aprobado_por": {
      "type": "string"
    },
    "notas": {
      "type": "string"
    }
  },
  "required": [
    "committee_member_id",
    "employee_id",
    "fecha",
    "horas_utilizadas",
    "motivo"
  ]
}