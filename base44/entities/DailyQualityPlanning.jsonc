{
  "name": "DailyQualityPlanning",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'Técnico'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'Técnico'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "fecha": {
      "type": "string",
      "format": "date",
      "description": "Fecha de la planificación"
    },
    "team_key": {
      "type": "string",
      "enum": [
        "team_1",
        "team_2"
      ],
      "description": "Equipo planificado"
    },
    "turno": {
      "type": "string",
      "enum": [
        "Mañana",
        "Tarde"
      ],
      "description": "Turno planificado"
    },
    "employee_id": {
      "type": "string",
      "description": "ID del empleado de calidad"
    },
    "funcion_asignada": {
      "type": "string",
      "description": "Función o tarea asignada"
    },
    "tipo_inspeccion": {
      "type": "string",
      "enum": [
        "Control de Proceso",
        "Control de Recepción",
        "Control Final",
        "Auditoría",
        "Metrología",
        "Otro"
      ],
      "description": "Tipo de inspección"
    },
    "lineas_asignadas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de máquinas/líneas asignadas para inspección"
    },
    "prioridad": {
      "type": "string",
      "enum": [
        "Baja",
        "Media",
        "Alta",
        "Urgente"
      ],
      "default": "Media",
      "description": "Prioridad de la función"
    },
    "notas": {
      "type": "string",
      "description": "Notas adicionales"
    },
    "estado": {
      "type": "string",
      "enum": [
        "Planificado",
        "En Curso",
        "Completado",
        "Cancelado"
      ],
      "default": "Planificado",
      "description": "Estado de la planificación"
    },
    "hora_inicio": {
      "type": "string",
      "description": "Hora de inicio estimada"
    },
    "hora_fin": {
      "type": "string",
      "description": "Hora de fin estimada"
    }
  },
  "required": [
    "fecha",
    "team_key",
    "turno",
    "employee_id",
    "funcion_asignada"
  ]
}
