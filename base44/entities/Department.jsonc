{
  "name": "Department",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "parent_id": {
      "type": "string"
    },
    "parent_name": {
      "type": "string"
    },
    "manager_id": {
      "type": "string"
    },
    "manager_id_2": {
      "type": "string"
    },
    "manager_id_3": {
      "type": "string"
    },
    "manager_id_4": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "total_employee_count": {
      "type": "number"
    },
    "orden": {
      "type": "number"
    }
  },
  "required": [
    "name"
  ]
}