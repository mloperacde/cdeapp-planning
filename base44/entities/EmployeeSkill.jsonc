{
  "name": "EmployeeSkill",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh' or user.role == 'supervisor' or user.employee_id == employee_id}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "ID del empleado"
    },
    "skill_id": {
      "type": "string",
      "description": "ID de la habilidad"
    },
    "machine_id": {
      "type": "string",
      "description": "ID de la m\u00e1quina (opcional)"
    },
    "nivel_competencia": {
      "type": "string",
      "enum": [
        "B\u00e1sico",
        "Intermedio",
        "Avanzado",
        "Experto"
      ],
      "default": "B\u00e1sico"
    },
    "experiencia_meses": {
      "type": "number"
    },
    "fecha_adquisicion": {
      "type": "string",
      "format": "date"
    },
    "fecha_ultima_evaluacion": {
      "type": "string",
      "format": "date"
    },
    "certificado": {
      "type": "boolean",
      "default": false
    },
    "certificado_url": {
      "type": "string"
    },
    "fecha_expiracion_certificado": {
      "type": "string",
      "format": "date"
    },
    "requiere_renovacion": {
      "type": "boolean",
      "default": false
    },
    "notas": {
      "type": "string"
    },
    "evaluador_id": {
      "type": "string"
    },
    "puntuacion_evaluacion": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    }
  },
  "required": [
    "employee_id",
    "skill_id",
    "nivel_competencia"
  ]
}