{
  "name": "MaintenanceType",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "nombre": {
      "type": "string"
    },
    "descripcion": {
      "type": "string"
    },
    "machine_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tarea_1": {
      "type": "object"
    },
    "tarea_2": {
      "type": "object"
    },
    "tarea_3": {
      "type": "object"
    },
    "tarea_4": {
      "type": "object"
    },
    "tarea_5": {
      "type": "object"
    },
    "tarea_6": {
      "type": "object"
    },
    "activo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "nombre"
  ]
}
