{
  "name": "AppConfig",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "config_key": {
      "type": "string",
      "description": "Clave única de configuración (ej: branding, manufacturing_config, maintenance_config)"
    },
    "value": {
      "type": "string",
      "description": "Valor de configuración serializado como JSON string (para configuraciones complejas)"
    },
    "app_name": {
      "type": "string",
      "description": "Nombre de la aplicación"
    },
    "app_subtitle": {
      "type": "string",
      "description": "Subtítulo de la aplicación"
    },
    "primary_color": {
      "type": "string",
      "description": "Color primario en formato hex"
    },
    "logo_url": {
      "type": "string",
      "description": "URL del logotipo"
    },
    "updated_by": {
      "type": "string",
      "description": "Email del usuario que actualizó"
    },
    "updated_by_name": {
      "type": "string",
      "description": "Nombre del usuario que actualizó"
    }
  },
  "required": [
    "config_key"
  ]
}
