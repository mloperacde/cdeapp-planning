{
  "name": "TeamConfig",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "team_key": {
      "type": "string",
      "enum": [
        "team_1",
        "team_2"
      ]
    },
    "team_name": {
      "type": "string"
    },
    "descripcion": {
      "type": "string"
    },
    "activo": {
      "type": "boolean",
      "default": true
    },
    "color": {
      "type": "string"
    }
  },
  "required": [
    "team_key",
    "team_name"
  ]
}