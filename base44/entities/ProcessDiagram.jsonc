{
  "name": "ProcessDiagram",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "room_layout_id": {
      "type": "string"
    },
    "room_layout_name": {
      "type": "string"
    },
    "process_id": {
      "type": "string"
    },
    "process_name": {
      "type": "string"
    },
    "operator_assignments": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "flow_connections": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "Borrador",
        "En Revisi\u00f3n",
        "Aprobado",
        "Obsoleto"
      ],
      "default": "Borrador"
    },
    "approved_by": {
      "type": "string"
    },
    "approval_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "room_layout_id",
    "process_id"
  ]
}