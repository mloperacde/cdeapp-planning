{
  "name": "ProcessDiagram",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "room_layout_id": {
      "type": "string"
    },
    "room_layout_name": {
      "type": "string"
    },
    "process_id": {
      "type": "string"
    },
    "process_name": {
      "type": "string"
    },
    "operator_assignments": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "flow_connections": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "linked_articles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "article_id": {
            "type": "string",
            "description": "ID del artículo en la BD"
          },
          "article_code": {
            "type": "string",
            "description": "Código del artículo"
          },
          "article_description": {
            "type": "string",
            "description": "Descripción/nombre del artículo"
          },
          "linked_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Artículos del catálogo CDEApp vinculados a este diagrama"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "Borrador",
        "En Revisión",
        "Aprobado",
        "Obsoleto"
      ],
      "default": "Borrador"
    },
    "approved_by": {
      "type": "string"
    },
    "approval_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "room_layout_id",
    "process_id"
  ]
}
