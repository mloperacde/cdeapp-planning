{
  "name": "MachineAssignment",
  "type": "object",
  "properties": {
    "machine_id": {
      "type": "string",
      "description": "ID de la m\u00e1quina"
    },
    "team_key": {
      "type": "string",
      "description": "Equipo al que aplica"
    },
    "responsable_linea": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de responsables de l\u00ednea"
    },
    "segunda_linea": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de segundas de l\u00ednea"
    },
    "operador_1": {
      "type": "string",
      "description": "ID operador 1"
    },
    "operador_2": {
      "type": "string",
      "description": "ID operador 2"
    },
    "operador_3": {
      "type": "string",
      "description": "ID operador 3"
    },
    "operador_4": {
      "type": "string",
      "description": "ID operador 4"
    },
    "operador_5": {
      "type": "string",
      "description": "ID operador 5"
    },
    "operador_6": {
      "type": "string",
      "description": "ID operador 6"
    },
    "operador_7": {
      "type": "string",
      "description": "ID operador 7"
    },
    "operador_8": {
      "type": "string",
      "description": "ID operador 8"
    }
  },
  "required": [
    "machine_id",
    "team_key"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "production_manager"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "production_manager"
          }
        },
        {
          "user_condition": {
            "role": "supervisor"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "production_manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "production_manager"
          }
        }
      ]
    }
  }
}