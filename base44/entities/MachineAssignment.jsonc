{
  "name": "MachineAssignment",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'jefe_turno'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'jefe_turno'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "machine_id": {
      "type": "string",
      "description": "ID de la máquina"
    },
    "team_key": {
      "type": "string",
      "description": "Equipo al que aplica"
    },
    "responsable_linea": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "segunda_linea": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "operador_1": {
      "type": "string"
    },
    "operador_2": {
      "type": "string"
    },
    "operador_3": {
      "type": "string"
    },
    "operador_4": {
      "type": "string"
    },
    "operador_5": {
      "type": "string"
    },
    "operador_6": {
      "type": "string"
    },
    "operador_7": {
      "type": "string"
    },
    "operador_8": {
      "type": "string"
    }
  },
  "required": [
    "machine_id",
    "team_key"
  ]
}
