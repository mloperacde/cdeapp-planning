{
  "name": "EmployeeIncentiveResult",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{true}}"
    },
    {
      "operation": "update",
      "allow": "{{true}}"
    },
    {
      "operation": "delete",
      "allow": "{{true}}"
    }
  ],
  "properties": {
    "incentive_plan_id": {
      "type": "string",
      "description": "ID del plan de incentivos"
    },
    "employee_id": {
      "type": "string",
      "description": "ID del empleado"
    },
    "departamento": {
      "type": "string",
      "description": "Departamento del empleado"
    },
    "periodo_evaluacion": {
      "type": "string",
      "description": "Período evaluado (ej. 2025-Q1, 2025-01)"
    },
    "resultados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "parametro": {
            "type": "string"
          },
          "valor_obtenido": {
            "type": "number"
          },
          "meta_objetivo": {
            "type": "number"
          },
          "peso_porcentaje": {
            "type": "number"
          },
          "porcentaje_cumplimiento": {
            "type": "number",
            "description": "% de cumplimiento calculado"
          },
          "puntos_obtenidos": {
            "type": "number",
            "description": "Puntos ponderados obtenidos"
          }
        }
      },
      "description": "Resultados de cada parámetro"
    },
    "cumplimiento_total": {
      "type": "number",
      "description": "Porcentaje total de cumplimiento"
    },
    "incentivo_calculado": {
      "type": "number",
      "description": "Monto del incentivo calculado"
    },
    "estado": {
      "type": "string",
      "enum": [
        "Pendiente",
        "En Revisión",
        "Aprobado",
        "Pagado"
      ],
      "default": "Pendiente"
    },
    "observaciones": {
      "type": "string"
    },
    "fecha_evaluacion": {
      "type": "string",
      "format": "date-time"
    },
    "evaluado_por": {
      "type": "string"
    }
  },
  "required": [
    "incentive_plan_id",
    "employee_id",
    "departamento",
    "periodo_evaluacion"
  ]
}
