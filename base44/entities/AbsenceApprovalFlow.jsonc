{
  "name": "AbsenceApprovalFlow",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "absence_type_id": {
      "type": "string"
    },
    "niveles": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "activo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "absence_type_id",
    "niveles"
  ]
}
