{
  "name": "UserFilterPreference",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email del usuario propietario del filtro"
    },
    "page_id": {
      "type": "string",
      "description": "Identificador único de la página o contexto (ej: 'employees', 'machines')"
    },
    "filters": {
      "type": "object",
      "description": "Objeto JSON con la configuración de filtros, búsqueda y ordenamiento"
    },
    "name": {
      "type": "string",
      "description": "Nombre del filtro guardado (opcional, para 'Vista Predeterminada')"
    },
    "is_default": {
      "type": "boolean",
      "default": true,
      "description": "Si es la vista por defecto para este usuario en esta página"
    }
  },
  "required": [
    "user_email",
    "page_id",
    "filters"
  ],
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{true}}"
    },
    {
      "operation": "update",
      "allow": "{{true}}"
    },
    {
      "operation": "delete",
      "allow": "{{true}}"
    }
  ]
}
