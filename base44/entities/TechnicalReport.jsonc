{
  "name": "TechnicalReport",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'Técnico' or user.role == 'supervisor'}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'Técnico'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'Técnico'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "tituloInforme": {
      "type": "string"
    },
    "estadoInforme": {
      "type": "string",
      "enum": [
        "Borrador",
        "En Revisión",
        "Pendiente",
        "Validado",
        "Rechazado"
      ],
      "default": "Borrador"
    },
    "tipoInforme": {
      "type": "string",
      "enum": [
        "Calificación de Instalación (IQ)",
        "Calificación Operacional (OQ)",
        "Calificación de Funcionamiento (PQ)",
        "Validación de Proceso",
        "Validación de Limpieza",
        "Validación de Método Analítico",
        "Otro"
      ]
    },
    "articulo": {
      "type": "string"
    },
    "productId": {
      "type": "string"
    },
    "sala": {
      "type": "string"
    },
    "linea": {
      "type": "string"
    },
    "lote": {
      "type": "string"
    },
    "fecha": {
      "type": "string",
      "format": "date"
    },
    "fechaInicio": {
      "type": "string",
      "format": "date"
    },
    "fechaFin": {
      "type": "string",
      "format": "date"
    },
    "autor": {
      "type": "string"
    },
    "departamento": {
      "type": "string"
    },
    "aprobadorQA": {
      "type": "string"
    },
    "objetivo": {
      "type": "string"
    },
    "alcance": {
      "type": "string"
    },
    "resumenEjecutivo": {
      "type": "string"
    },
    "metodologia": {
      "type": "string"
    },
    "hallazgos": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidencias": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "conclusiones": {
      "type": "string"
    },
    "recomendaciones": {
      "type": "string"
    },
    "firmaAutor": {
      "type": "boolean",
      "default": false
    },
    "firmaQA": {
      "type": "boolean",
      "default": false
    },
    "numeroInforme": {
      "type": "string"
    }
  },
  "required": [
    "tituloInforme",
    "estadoInforme",
    "autor",
    "fecha"
  ]
}
