{
  "name": "AbsenceDaysBalance",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh' or user.role == 'supervisor' or user.employee_id == employee_id}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh' or user.role == 'supervisor'}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "anio": {
      "type": "number"
    },
    "tipo_permiso": {
      "type": "string",
      "enum": [
        "Vacaciones",
        "Asuntos Propios",
        "Permiso Matrimonio",
        "Permiso Paternidad/Maternidad",
        "Permiso Lactancia",
        "Permiso M\u00e9dico Familiar",
        "Permiso Examen",
        "Permiso Mudanza",
        "Otro Permiso Remunerado"
      ]
    },
    "dias_totales_derecho": {
      "type": "number"
    },
    "dias_disfrutados": {
      "type": "number",
      "default": 0
    },
    "dias_pendientes": {
      "type": "number"
    },
    "periodos_disfrutados": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "observaciones": {
      "type": "string"
    }
  },
  "required": [
    "employee_id",
    "anio",
    "tipo_permiso"
  ]
}