{
  "name": "Skill",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "nombre": {
      "type": "string"
    },
    "codigo": {
      "type": "string"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "T\u00e9cnica",
        "Seguridad",
        "Calidad",
        "Maquinaria",
        "Proceso",
        "Software",
        "Idiomas",
        "Otra"
      ],
      "default": "T\u00e9cnica"
    },
    "descripcion": {
      "type": "string"
    },
    "activo": {
      "type": "boolean",
      "default": true
    },
    "departamentos_aplicables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "nombre",
    "codigo"
  ]
}