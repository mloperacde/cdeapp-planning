{
  "name": "Absence",
  "type": "object",
  "row_level_security": [
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh' or user.role == 'supervisor' or user.employee_id == employee_id}}"
    },
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh' or user.role == 'supervisor' or user.employee_id == employee_id}}"
    },
    {
      "operation": "update",
      "allow": "{{(user.role == 'admin' or user.role == 'rrhh' or user.role == 'supervisor') or (user.employee_id == employee_id and estado_aprobacion == 'Pendiente')}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "fecha_inicio": {
      "type": "string",
      "format": "date-time"
    },
    "fecha_fin": {
      "type": "string",
      "format": "date-time"
    },
    "fecha_fin_desconocida": {
      "type": "boolean",
      "default": false
    },
    "motivo": {
      "type": "string"
    },
    "tipo": {
      "type": "string"
    },
    "absence_type_id": {
      "type": "string"
    },
    "remunerada": {
      "type": "boolean",
      "default": true
    },
    "notas": {
      "type": "string"
    },
    "estado_aprobacion": {
      "type": "string",
      "enum": [
        "Pendiente",
        "Aprobada",
        "Rechazada",
        "Cancelada"
      ],
      "default": "Pendiente"
    },
    "solicitado_por": {
      "type": "string"
    },
    "aprobado_por": {
      "type": "string"
    },
    "fecha_aprobacion": {
      "type": "string",
      "format": "date-time"
    },
    "comentario_aprobacion": {
      "type": "string"
    },
    "documentos_adjuntos": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "flujo_aprobacion": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "employee_id",
    "fecha_inicio",
    "motivo"
  ]
}