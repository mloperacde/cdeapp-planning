{
  "name": "Absence",
  "type": "object",
  "row_level_security": [
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'rrhh' or user.role == 'supervisor' or user.employee_id == employee_id}}"
    },
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'rrhh' or user.role == 'supervisor' or user.employee_id == employee_id}}"
    },
    {
      "operation": "update",
      "allow": "{{(user.role == 'admin' or user.role == 'Admin' or user.role == 'rrhh' or user.role == 'supervisor') or (user.employee_id == employee_id and estado_aprobacion == 'Pendiente')}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "fecha_inicio": {
      "type": "string",
      "format": "date-time"
    },
    "fecha_fin": {
      "type": "string",
      "format": "date-time"
    },
    "fecha_fin_desconocida": {
      "type": "boolean",
      "default": false
    },
    "motivo": {
      "type": "string"
    },
    "tipo": {
      "type": "string"
    },
    "absence_type_id": {
      "type": "string"
    },
    "remunerada": {
      "type": "boolean",
      "default": true
    },
    "notas": {
      "type": "string"
    },
    "estado_aprobacion": {
      "type": "string",
      "enum": [
        "Pendiente",
        "Aprobada",
        "Rechazada",
        "Cancelada"
      ],
      "default": "Pendiente"
    },
    "solicitado_por": {
      "type": "string"
    },
    "aprobado_por": {
      "type": "string"
    },
    "fecha_aprobacion": {
      "type": "string",
      "format": "date-time"
    },
    "comentario_aprobacion": {
      "type": "string"
    },
    "documentos_adjuntos": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "flujo_aprobacion": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "ignore_protection_balance": {
      "type": "boolean",
      "default": false,
      "description": "Excluye la ausencia del c\u00e1lculo de protecci\u00f3n de vacaciones"
    },
    "compensacion_vacaciones_pendientes": {
      "type": "boolean",
      "default": false,
      "description": "Ausencia justificada descontando d\u00edas del saldo de vacaciones pendientes de disfrutar"
    },
    "dias_vacaciones_compensados": {
      "type": "number",
      "description": "D\u00edas descontados del saldo de vacaciones pendientes al justificar la ausencia"
    },
    "compensacion_vacaciones": {
      "type": "object",
      "description": "Trazabilidad de la compensaci\u00f3n aplicada sobre el saldo de vacaciones pendientes",
      "properties": {
        "aplicada": {
          "type": "boolean",
          "default": false
        },
        "dias_compensados": {
          "type": "number"
        },
        "dias_disponibles_antes": {
          "type": "number"
        },
        "dias_disponibles_despues": {
          "type": "number"
        },
        "fecha_aplicacion": {
          "type": "string",
          "format": "date-time"
        },
        "aplicado_por": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "employee_id",
    "fecha_inicio",
    "motivo"
  ]
}