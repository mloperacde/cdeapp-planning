{
  "name": "BreakRecord",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh' or user.role == 'supervisor'}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "employee_code": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "record_date": {
      "type": "string",
      "format": "date"
    },
    "shift": {
      "type": "string",
      "enum": [
        "Ma\u00f1ana",
        "Tarde",
        "Noche",
        "N/A"
      ]
    },
    "break_type": {
      "type": "string"
    },
    "break_start": {
      "type": "string"
    },
    "break_end": {
      "type": "string"
    },
    "duration_minutes": {
      "type": "number"
    },
    "work_session_start": {
      "type": "string"
    },
    "work_session_end": {
      "type": "string"
    },
    "total_work_minutes": {
      "type": "number"
    },
    "import_batch": {
      "type": "string"
    }
  },
  "required": [
    "employee_id",
    "record_date",
    "break_type",
    "break_start"
  ]
}