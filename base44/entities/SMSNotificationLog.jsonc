{
  "name": "SMSNotificationLog",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "create",
      "allow": "{{true}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "telefono": {
      "type": "string"
    },
    "mensaje": {
      "type": "string"
    },
    "tipo_evento": {
      "type": "string"
    },
    "absence_id": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "estado": {
      "type": "string",
      "enum": [
        "Pendiente",
        "Enviado",
        "Error",
        "Entregado"
      ],
      "default": "Pendiente"
    },
    "fecha_envio": {
      "type": "string",
      "format": "date-time"
    },
    "error_mensaje": {
      "type": "string"
    },
    "proveedor": {
      "type": "string"
    }
  },
  "required": [
    "telefono",
    "mensaje",
    "tipo_evento"
  ]
}
