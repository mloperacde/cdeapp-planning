{
  "name": "SalaryComponent",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{true}}"
    },
    {
      "operation": "update",
      "allow": "{{true}}"
    },
    {
      "operation": "delete",
      "allow": "{{true}}"
    }
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Fijo",
        "Variable",
        "Deducción",
        "Beneficio",
        "Plus",
        "Complemento"
      ],
      "default": "Fijo"
    },
    "category": {
      "type": "string",
      "enum": [
        "Salario Base",
        "Complementos Salariales",
        "Pluses",
        "Deducciones",
        "Beneficios Sociales",
        "Otros"
      ]
    },
    "is_taxable": {
      "type": "boolean",
      "default": true
    },
    "is_social_security_contributory": {
      "type": "boolean",
      "default": true
    },
    "calculation_method": {
      "type": "string",
      "enum": [
        "Fijo",
        "Porcentaje Salario Base",
        "Fórmula Personalizada",
        "Por Horas",
        "Por Días"
      ],
      "default": "Fijo"
    },
    "default_value": {
      "type": "number"
    },
    "formula": {
      "type": "string"
    },
    "applies_to_all": {
      "type": "boolean",
      "default": false
    },
    "applicable_departments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "applicable_positions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "periodicity": {
      "type": "string",
      "enum": [
        "Mensual",
        "Trimestral",
        "Semestral",
        "Anual",
        "Única"
      ],
      "default": "Mensual"
    },
    "description": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "code",
    "type"
  ]
}
