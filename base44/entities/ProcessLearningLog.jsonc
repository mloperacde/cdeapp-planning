{
  "name": "ProcessLearningLog",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{true}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "article_id": {
      "type": "string",
      "description": "ID del artículo en nuestra BD"
    },
    "article_code": {
      "type": "string",
      "description": "Código del artículo"
    },
    "article_name": {
      "type": "string",
      "description": "Nombre del artículo"
    },
    "article_type": {
      "type": "string",
      "description": "Tipo de artículo (Frasco, Bote, Estuche...)"
    },
    "components_snapshot": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Snapshot de los componentes del artículo en el momento del aprendizaje"
    },
    "suggested_activities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de actividades sugeridas por la IA"
    },
    "final_activities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de actividades finales (después de correcciones manuales)"
    },
    "corrections_made": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Lista de correcciones realizadas: {action: added/removed, activity_id, activity_name, reason}"
    },
    "similar_article_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de artículos con procesos similares detectados"
    },
    "confidence_score": {
      "type": "number",
      "description": "Puntuación de confianza de la detección automática (0-1)"
    },
    "process_code": {
      "type": "string",
      "description": "Código de proceso asignado (si aplica)"
    },
    "total_time_seconds": {
      "type": "number",
      "description": "Tiempo total estimado del proceso"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Usuario que revisó/corrigió"
    },
    "review_date": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_review",
        "reviewed",
        "auto_applied"
      ],
      "default": "pending_review"
    },
    "learning_notes": {
      "type": "string",
      "description": "Instrucciones adicionales del operario para que la IA las tenga en cuenta en futuros análisis"
    }
  },
  "required": [
    "article_id",
    "article_code"
  ]
}
