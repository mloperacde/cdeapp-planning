{
  "name": "EmployeeAuditLog",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "action_type": {
      "type": "string",
      "enum": [
        "view_sensitive",
        "create",
        "update",
        "delete",
        "export"
      ],
      "description": "Tipo de acci\u00f3n realizada"
    },
    "user_email": {
      "type": "string",
      "description": "Email del usuario que realiz\u00f3 la acci\u00f3n"
    },
    "target_employee_id": {
      "type": "string",
      "description": "ID del empleado afectado"
    },
    "target_employee_name": {
      "type": "string",
      "description": "Nombre del empleado afectado"
    },
    "details": {
      "type": "object",
      "description": "Detalles de la acci\u00f3n (campos vistos, cambios realizados, etc.)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora de la acci\u00f3n"
    },
    "ip_address": {
      "type": "string",
      "description": "Direcci\u00f3n IP (opcional si disponible)"
    }
  },
  "required": [
    "action_type",
    "user_email",
    "timestamp"
  ]
}