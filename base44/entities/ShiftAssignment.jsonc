{
  "name": "ShiftAssignment",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'jefe_turno'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'jefe_turno' or (user.employee_id == employee_id and estado == 'Programado')}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'jefe_turno'}}"
    }
  ],
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "fecha": {
      "type": "string",
      "format": "date"
    },
    "turno": {
      "type": "string",
      "enum": [
        "Ma\u00f1ana",
        "Tarde",
        "Noche"
      ]
    },
    "hora_inicio": {
      "type": "string"
    },
    "hora_fin": {
      "type": "string"
    },
    "maquinas_asignadas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estado": {
      "type": "string",
      "enum": [
        "Programado",
        "Confirmado",
        "En Curso",
        "Completado",
        "Cancelado"
      ],
      "default": "Programado"
    },
    "notas": {
      "type": "string"
    },
    "creado_por": {
      "type": "string"
    },
    "modificado_por": {
      "type": "string"
    }
  },
  "required": [
    "employee_id",
    "fecha",
    "turno",
    "hora_inicio",
    "hora_fin"
  ]
}