{
  "name": "DailyMachinePlanning",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'jefe_turno'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'jefe_turno'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de la planificación"
    },
    "shift": {
      "type": "string",
      "enum": [
        "Mañana",
        "Tarde",
        "Noche"
      ],
      "description": "Turno de trabajo"
    },
    "machine_id": {
      "type": "string",
      "description": "ID de la máquina"
    },
    "team_key": {
      "type": "string",
      "description": "Equipo para el que se planifica"
    },
    "process_id": {
      "type": "string",
      "description": "ID del proceso seleccionado"
    },
    "activa": {
      "type": "boolean",
      "default": true,
      "description": "Si la máquina está activa en el planning"
    },
    "operadores_necesarios": {
      "type": "number",
      "description": "Número de operadores necesarios"
    },
    "responsable_linea": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de responsables de línea"
    },
    "segunda_linea": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de segundas de línea"
    },
    "operador_1": {
      "type": "string",
      "description": "ID operador 1"
    },
    "operador_2": {
      "type": "string",
      "description": "ID operador 2"
    },
    "operador_3": {
      "type": "string",
      "description": "ID operador 3"
    },
    "operador_4": {
      "type": "string",
      "description": "ID operador 4"
    },
    "operador_5": {
      "type": "string",
      "description": "ID operador 5"
    },
    "operador_6": {
      "type": "string",
      "description": "ID operador 6"
    },
    "operador_7": {
      "type": "string",
      "description": "ID operador 7"
    },
    "operador_8": {
      "type": "string",
      "description": "ID operador 8"
    },
    "status": {
      "type": "string",
      "enum": [
        "Borrador",
        "Confirmado"
      ],
      "default": "Borrador",
      "description": "Estado de la planificación"
    },
    "notes": {
      "type": "string",
      "description": "Notas sobre la asignación"
    },
    "migration_from": {
      "type": "string",
      "enum": [
        "MachinePlanning",
        "DailyMachineStaffing"
      ],
      "description": "Origen de migración"
    }
  },
  "required": [
    "date",
    "machine_id"
  ]
}
