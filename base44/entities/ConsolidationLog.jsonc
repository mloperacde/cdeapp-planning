{
  "name": "ConsolidationLog",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "task_name": {
      "type": "string"
    },
    "triggered_by": {
      "type": "string",
      "enum": [
        "scheduled",
        "manual"
      ],
      "default": "scheduled"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "warning",
        "error",
        "running"
      ],
      "default": "running"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "number"
    },
    "summary": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "anomalies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "notification_sent": {
      "type": "boolean",
      "default": false
    },
    "notification_email": {
      "type": "string"
    }
  },
  "required": [
    "task_name",
    "status",
    "started_at"
  ]
}