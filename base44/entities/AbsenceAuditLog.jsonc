{
  "name": "AbsenceAuditLog",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "employee_dept": {
      "type": "string"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "reactivacion_por_presencia",
        "ausencia_confirmada",
        "ausencia_auto_creada",
        "ausencia_cerrada_sistema",
        "ausencia_manual_creada",
        "ausencia_manual_aprobada",
        "ausencia_manual_rechazada",
        "retraso_detectado",
        "turno_reset",
        "turno_iniciado"
      ]
    },
    "absence_id": {
      "type": "string"
    },
    "sync_date": {
      "type": "string",
      "format": "date"
    },
    "turno_afectado": {
      "type": "string",
      "enum": [
        "Ma\u00f1ana",
        "Tarde",
        "Noche",
        "No aplica"
      ]
    },
    "turno_inicio_esperado": {
      "type": "string"
    },
    "turno_fin_esperado": {
      "type": "string"
    },
    "hora_evento": {
      "type": "string",
      "format": "date-time"
    },
    "origen": {
      "type": "string",
      "enum": [
        "cucoSyncV2",
        "shiftAudit",
        "manual_rrhh",
        "sistema"
      ],
      "default": "shiftAudit"
    },
    "estado_anterior": {
      "type": "string"
    },
    "estado_nuevo": {
      "type": "string"
    },
    "motivo": {
      "type": "string"
    },
    "leido_por_rrhh": {
      "type": "boolean",
      "default": false
    },
    "notas": {
      "type": "string"
    }
  },
  "required": [
    "employee_id",
    "employee_name",
    "action_type",
    "sync_date",
    "origen"
  ]
}