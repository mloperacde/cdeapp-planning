{
  "name": "NotificationPreference",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.email == user_email or user.role == 'admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.email == user_email or user.role == 'admin'}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "user_email": {
      "type": "string"
    },
    "notification_types": {
      "type": "object"
    },
    "quiet_hours": {
      "type": "object"
    }
  },
  "required": [
    "user_email"
  ]
}