{
  "name": "ProfileChangeRequest",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "ID del empleado que solicita el cambio"
    },
    "campo_modificado": {
      "type": "string",
      "description": "Campo que se solicita modificar"
    },
    "valor_actual": {
      "type": "string",
      "description": "Valor actual del campo"
    },
    "valor_solicitado": {
      "type": "string",
      "description": "Nuevo valor solicitado"
    },
    "categoria_cambio": {
      "type": "string",
      "enum": [
        "Contacto",
        "Dirección",
        "Emergencia",
        "Bancario"
      ],
      "description": "Categoría del cambio solicitado"
    },
    "estado": {
      "type": "string",
      "enum": [
        "Pendiente",
        "Aprobado",
        "Rechazado"
      ],
      "default": "Pendiente",
      "description": "Estado de la solicitud"
    },
    "motivo_rechazo": {
      "type": "string",
      "description": "Motivo del rechazo si aplica"
    },
    "fecha_solicitud": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de la solicitud"
    },
    "fecha_respuesta": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de aprobación o rechazo"
    },
    "aprobado_por": {
      "type": "string",
      "description": "ID del usuario que aprobó/rechazó"
    },
    "notas": {
      "type": "string",
      "description": "Notas adicionales sobre el cambio"
    }
  },
  "required": [
    "employee_id",
    "campo_modificado",
    "valor_solicitado",
    "categoria_cambio"
  ],
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{true}}"
    },
    {
      "operation": "update",
      "allow": "{{true}}"
    },
    {
      "operation": "delete",
      "allow": "{{true}}"
    }
  ]
}
