{
  "name": "DepartmentPositionSkill",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "departamento": {
      "type": "string",
      "description": "Departamento al que aplica"
    },
    "puesto": {
      "type": "string",
      "description": "Puesto específico dentro del departamento"
    },
    "skill_id": {
      "type": "string",
      "description": "ID de la habilidad"
    },
    "importancia": {
      "type": "string",
      "enum": [
        "Media",
        "Requerida",
        "Crítica"
      ],
      "default": "Media",
      "description": "Nivel de importancia de la habilidad"
    },
    "nivel_minimo_requerido": {
      "type": "string",
      "enum": [
        "Básico",
        "Intermedio",
        "Avanzado",
        "Experto"
      ],
      "default": "Básico",
      "description": "Nivel mínimo requerido"
    },
    "nivel_deseable": {
      "type": "string",
      "enum": [
        "Básico",
        "Intermedio",
        "Avanzado",
        "Experto"
      ],
      "description": "Nivel deseable (opcional, superior al mínimo)"
    },
    "obligatorio": {
      "type": "boolean",
      "default": true,
      "description": "Si es obligatorio tener esta habilidad"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripción o justificación del requisito"
    },
    "activo": {
      "type": "boolean",
      "default": true,
      "description": "Si el requisito está activo"
    }
  },
  "required": [
    "departamento",
    "puesto",
    "skill_id",
    "importancia",
    "nivel_minimo_requerido"
  ]
}
