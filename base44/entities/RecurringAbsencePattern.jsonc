{
  "name": "RecurringAbsencePattern",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{true}}"
    },
    {
      "operation": "update",
      "allow": "{{true}}"
    },
    {
      "operation": "delete",
      "allow": "{{true}}"
    }
  ],
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "tipo_ausencia": {
      "type": "string"
    },
    "patron_detectado": {
      "type": "string",
      "enum": [
        "Lunes",
        "Viernes",
        "Lunes/Viernes",
        "Días específicos",
        "Mensual",
        "Otro"
      ]
    },
    "numero_repeticiones": {
      "type": "number"
    },
    "periodo_analisis": {
      "type": "string"
    },
    "fecha_inicio_periodo": {
      "type": "string",
      "format": "date"
    },
    "fecha_fin_periodo": {
      "type": "string",
      "format": "date"
    },
    "ausencias_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nivel_alerta": {
      "type": "string",
      "enum": [
        "Bajo",
        "Medio",
        "Alto"
      ]
    },
    "requiere_revision": {
      "type": "boolean",
      "default": false
    },
    "revisado_por": {
      "type": "string"
    },
    "fecha_revision": {
      "type": "string",
      "format": "date-time"
    },
    "notas_revision": {
      "type": "string"
    },
    "activo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "employee_id",
    "tipo_ausencia",
    "numero_repeticiones"
  ]
}
