{
  "name": "SalaryChangeRequest",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{true}}"
    },
    {
      "operation": "update",
      "allow": "{{true}}"
    },
    {
      "operation": "delete",
      "allow": "{{true}}"
    }
  ],
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "Nuevo Componente",
        "Modificación Componente",
        "Eliminación Componente",
        "Cambio Categoría",
        "Ajuste Salarial"
      ]
    },
    "component_id": {
      "type": "string"
    },
    "component_name": {
      "type": "string"
    },
    "current_amount": {
      "type": "number"
    },
    "requested_amount": {
      "type": "number"
    },
    "change_reason": {
      "type": "string"
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "requested_by": {
      "type": "string"
    },
    "requested_by_name": {
      "type": "string"
    },
    "request_date": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pendiente",
        "En Revisión",
        "Aprobada",
        "Rechazada",
        "Aplicada"
      ],
      "default": "Pendiente"
    },
    "approval_flow": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "approved_by": {
      "type": "string"
    },
    "approval_date": {
      "type": "string",
      "format": "date-time"
    },
    "rejection_reason": {
      "type": "string"
    },
    "applied_by": {
      "type": "string"
    },
    "applied_date": {
      "type": "string",
      "format": "date-time"
    },
    "related_data": {
      "type": "object"
    }
  },
  "required": [
    "employee_id",
    "request_type",
    "requested_by",
    "request_date"
  ]
}
