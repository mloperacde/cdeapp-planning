{
  "name": "DashboardWidgetConfig",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "update",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{true}}"
    },
    {
      "operation": "delete",
      "allow": "{{true}}"
    }
  ],
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID del usuario (null para configuración por defecto de rol)"
    },
    "role": {
      "type": "string",
      "description": "Rol al que aplica (admin, user, rrhh, supervisor)"
    },
    "dashboard_name": {
      "type": "string",
      "description": "Nombre del dashboard personalizado"
    },
    "widgets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "widget_id": {
            "type": "string",
            "enum": [
              "absence_trends",
              "approval_times",
              "absence_distribution",
              "absenteeism_rate",
              "sync_status",
              "contract_expiring",
              "upcoming_absences",
              "team_availability"
            ]
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "position": {
            "type": "number"
          },
          "size": {
            "type": "string",
            "enum": [
              "small",
              "medium",
              "large",
              "full"
            ],
            "default": "medium"
          },
          "config": {
            "type": "object",
            "description": "Configuración específica del widget"
          }
        }
      },
      "description": "Lista de widgets configurados"
    },
    "activo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "role",
    "dashboard_name",
    "widgets"
  ]
}
