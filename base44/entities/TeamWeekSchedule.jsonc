{
  "name": "TeamWeekSchedule",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{true}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'jefe_turno'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'jefe_turno'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "team_key": {
      "type": "string",
      "enum": [
        "team_1",
        "team_2"
      ]
    },
    "fecha_inicio_semana": {
      "type": "string",
      "format": "date"
    },
    "turno": {
      "type": "string",
      "enum": [
        "Mañana",
        "Tarde"
      ]
    },
    "notas": {
      "type": "string"
    }
  },
  "required": [
    "team_key",
    "fecha_inicio_semana",
    "turno"
  ]
}
