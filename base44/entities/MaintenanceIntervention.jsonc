{
  "name": "MaintenanceIntervention",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'T\u00e9cnico' or user.role == 'supervisor'}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'T\u00e9cnico'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'T\u00e9cnico'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo breve de la intervenci\u00f3n"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Acci\u00f3n",
        "Modificaci\u00f3n",
        "Mejora",
        "Resoluci\u00f3n de Incidencia",
        "Mejora de Instalaci\u00f3n",
        "Mejora de M\u00e1quina",
        "Otro"
      ],
      "default": "Acci\u00f3n"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripci\u00f3n detallada de la intervenci\u00f3n o problema a resolver"
    },
    "estado": {
      "type": "string",
      "enum": [
        "Pendiente",
        "En Progreso",
        "En Revisi\u00f3n",
        "Completada",
        "Cancelada"
      ],
      "default": "Pendiente"
    },
    "prioridad": {
      "type": "string",
      "enum": [
        "Baja",
        "Media",
        "Alta",
        "Cr\u00edtica"
      ],
      "default": "Media"
    },
    "solicitante_nombre": {
      "type": "string"
    },
    "solicitante_email": {
      "type": "string"
    },
    "solicitante_departamento": {
      "type": "string"
    },
    "destinatarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "rol": {
            "type": "string"
          }
        }
      }
    },
    "objetivo_tipo": {
      "type": "string",
      "enum": [
        "Global",
        "\u00c1rea",
        "Sala",
        "M\u00e1quina",
        "Sala-M\u00e1quina",
        "Instalaci\u00f3n",
        "Personalizado"
      ],
      "default": "Personalizado"
    },
    "objetivo_maquina_id": {
      "type": "string"
    },
    "objetivo_maquina_nombre": {
      "type": "string"
    },
    "objetivo_area": {
      "type": "string"
    },
    "objetivo_sala": {
      "type": "string"
    },
    "objetivo_descripcion_manual": {
      "type": "string"
    },
    "necesidades": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "Herramienta",
              "Material",
              "Personal",
              "Tiempo",
              "Permiso",
              "Otro"
            ]
          },
          "descripcion": {
            "type": "string"
          },
          "cantidad": {
            "type": "string"
          },
          "disponible": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "fecha_solicitud": {
      "type": "string",
      "format": "date-time"
    },
    "fecha_inicio_prevista": {
      "type": "string",
      "format": "date"
    },
    "fecha_fin_prevista": {
      "type": "string",
      "format": "date"
    },
    "fecha_completada": {
      "type": "string",
      "format": "date-time"
    },
    "imagenes_adjuntas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "descripcion": {
            "type": "string"
          }
        }
      }
    },
    "progreso": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fecha": {
            "type": "string",
            "format": "date-time"
          },
          "descripcion": {
            "type": "string"
          },
          "estado": {
            "type": "string"
          },
          "porcentaje": {
            "type": "number"
          },
          "registrado_por": {
            "type": "string"
          },
          "registrado_por_nombre": {
            "type": "string"
          }
        }
      }
    },
    "resolucion": {
      "type": "object",
      "properties": {
        "descripcion": {
          "type": "string"
        },
        "fecha": {
          "type": "string",
          "format": "date-time"
        },
        "firmado_por": {
          "type": "string"
        },
        "firmado_por_nombre": {
          "type": "string"
        },
        "satisfactorio": {
          "type": "boolean"
        }
      }
    },
    "numero_orden": {
      "type": "string"
    },
    "notas_adicionales": {
      "type": "string"
    }
  },
  "required": [
    "titulo",
    "tipo",
    "descripcion",
    "estado",
    "prioridad"
  ]
}