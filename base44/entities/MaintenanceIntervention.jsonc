{
  "name": "MaintenanceIntervention",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'Técnico' or user.role == 'supervisor'}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'Técnico'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'Admin' or user.role == 'Técnico'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin' or user.role == 'Admin'}}"
    }
  ],
  "properties": {
    "titulo": {
      "type": "string",
      "description": "Título breve de la intervención"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Acción",
        "Modificación",
        "Mejora",
        "Resolución de Incidencia",
        "Mejora de Instalación",
        "Mejora de Máquina",
        "Otro"
      ],
      "default": "Acción"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripción detallada de la intervención o problema a resolver"
    },
    "estado": {
      "type": "string",
      "enum": [
        "Pendiente",
        "En Progreso",
        "En Revisión",
        "Completada",
        "Cancelada"
      ],
      "default": "Pendiente"
    },
    "prioridad": {
      "type": "string",
      "enum": [
        "Baja",
        "Media",
        "Alta",
        "Crítica"
      ],
      "default": "Media"
    },
    "solicitante_nombre": {
      "type": "string"
    },
    "solicitante_email": {
      "type": "string"
    },
    "solicitante_departamento": {
      "type": "string"
    },
    "destinatarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "rol": {
            "type": "string"
          }
        }
      }
    },
    "objetivo_tipo": {
      "type": "string",
      "enum": [
        "Global",
        "Área",
        "Sala",
        "Máquina",
        "Sala-Máquina",
        "Instalación",
        "Personalizado"
      ],
      "default": "Personalizado"
    },
    "objetivo_maquina_id": {
      "type": "string"
    },
    "objetivo_maquina_nombre": {
      "type": "string"
    },
    "objetivo_area": {
      "type": "string"
    },
    "objetivo_sala": {
      "type": "string"
    },
    "objetivo_descripcion_manual": {
      "type": "string"
    },
    "necesidades": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "Herramienta",
              "Material",
              "Personal",
              "Tiempo",
              "Permiso",
              "Otro"
            ]
          },
          "descripcion": {
            "type": "string"
          },
          "cantidad": {
            "type": "string"
          },
          "disponible": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "fecha_solicitud": {
      "type": "string",
      "format": "date-time"
    },
    "fecha_inicio_prevista": {
      "type": "string",
      "format": "date"
    },
    "fecha_fin_prevista": {
      "type": "string",
      "format": "date"
    },
    "fecha_completada": {
      "type": "string",
      "format": "date-time"
    },
    "imagenes_adjuntas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "descripcion": {
            "type": "string"
          }
        }
      }
    },
    "progreso": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fecha": {
            "type": "string",
            "format": "date-time"
          },
          "descripcion": {
            "type": "string"
          },
          "estado": {
            "type": "string"
          },
          "porcentaje": {
            "type": "number"
          },
          "registrado_por": {
            "type": "string"
          },
          "registrado_por_nombre": {
            "type": "string"
          }
        }
      }
    },
    "resolucion": {
      "type": "object",
      "properties": {
        "descripcion": {
          "type": "string"
        },
        "fecha": {
          "type": "string",
          "format": "date-time"
        },
        "firmado_por": {
          "type": "string"
        },
        "firmado_por_nombre": {
          "type": "string"
        },
        "satisfactorio": {
          "type": "boolean"
        }
      }
    },
    "numero_orden": {
      "type": "string"
    },
    "notas_adicionales": {
      "type": "string"
    }
  },
  "required": [
    "titulo",
    "tipo",
    "descripcion",
    "estado",
    "prioridad"
  ]
}
