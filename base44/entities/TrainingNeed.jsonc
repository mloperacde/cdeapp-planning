{
  "name": "TrainingNeed",
  "type": "object",
  "row_level_security": [
    {
      "operation": "read",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh' or user.role == 'supervisor' or user.employee_id == employee_id}}"
    },
    {
      "operation": "create",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "update",
      "allow": "{{user.role == 'admin' or user.role == 'rrhh'}}"
    },
    {
      "operation": "delete",
      "allow": "{{user.role == 'admin'}}"
    }
  ],
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "skill_id": {
      "type": "string"
    },
    "nivel_actual": {
      "type": "string",
      "enum": [
        "Ninguno",
        "B\u00e1sico",
        "Intermedio",
        "Avanzado",
        "Experto"
      ],
      "default": "Ninguno"
    },
    "nivel_objetivo": {
      "type": "string",
      "enum": [
        "B\u00e1sico",
        "Intermedio",
        "Avanzado",
        "Experto"
      ]
    },
    "prioridad": {
      "type": "string",
      "enum": [
        "Baja",
        "Media",
        "Alta",
        "Urgente"
      ],
      "default": "Media"
    },
    "razon": {
      "type": "string"
    },
    "proceso_relacionado_id": {
      "type": "string"
    },
    "fecha_identificacion": {
      "type": "string",
      "format": "date-time"
    },
    "fecha_objetivo": {
      "type": "string",
      "format": "date"
    },
    "estado": {
      "type": "string",
      "enum": [
        "Pendiente",
        "En Progreso",
        "Completada",
        "Cancelada"
      ],
      "default": "Pendiente"
    },
    "training_module_id": {
      "type": "string"
    },
    "notas": {
      "type": "string"
    }
  },
  "required": [
    "employee_id",
    "skill_id",
    "nivel_objetivo"
  ]
}